@using ItchyPassword.Core.Encoding
@using ItchyPassword.Core.Services
@inject IJSRuntime JS
@implements IDisposable

<div class="totp-display">
    @if (string.IsNullOrWhiteSpace(Secret))
    {
        <div class="alert info alert-inline-sm">No TOTP secret to display.</div>
    }
    else if (string.IsNullOrWhiteSpace(_error) == false)
    {
        <div class="alert danger alert-inline-sm">@_error</div>
    }
    else
    {
        <div class="totp-code-row">
            <span class="totp-code">@FormatCode(_currentCode)</span>
            <CopyButton Text="@_currentCode" />
        </div>
        <div class="totp-timer">
            <div class="totp-timer-bar">
                <div class="totp-timer-fill" @ref="_fillRef"></div>
            </div>
            <span class="totp-timer-text">@_remainingSeconds s</span>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The Base32-encoded TOTP secret.
    /// </summary>
    [Parameter]
    public required string Secret { get; init; }

    private string _currentCode = string.Empty;
    private int _remainingSeconds = 30;
    private string _error = string.Empty;
    private bool _isResetting;
    private bool _hasRendered;
    private ElementReference _fillRef;
    private Timer? _timer;

    /// <summary>
    /// Pre-decoded secret bytes, cached to avoid Base32 decoding every second.
    /// </summary>
    private byte[]? _secretBytes;

    protected override void OnInitialized()
    {
        try
        {
            _secretBytes = Base32.Decode(Secret);
        }
        catch (Exception ex)
        {
            _error = $"Invalid TOTP secret: {ex.Message}";
        }

        Refresh();
        _timer = new Timer(OnTick, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hasRendered = true;
            int percentage = _remainingSeconds * 100 / 30;
            await JS.InvokeVoidAsync("domInterop.setWidthAnimated", _fillRef, percentage, false);
        }
    }

    private void OnTick(object? state)
    {
        _ = InvokeAsync(async () =>
        {
            Refresh();
            if (_hasRendered)
            {
                int percentage = _remainingSeconds * 100 / 30;
                await JS.InvokeVoidAsync("domInterop.setWidthAnimated", _fillRef, percentage, _isResetting);
            }
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        if (_secretBytes is null)
        {
            return;
        }

        try
        {
            _currentCode = TotpGenerator.GenerateCode(_secretBytes, DateTime.UtcNow);
            int remaining = TotpGenerator.GetRemainingSeconds();
            _isResetting = remaining > _remainingSeconds;
            _remainingSeconds = remaining;
            _error = string.Empty;
        }
        catch (Exception ex)
        {
            _currentCode = string.Empty;
            _remainingSeconds = 0;
            _isResetting = false;
            _error = $"Invalid TOTP secret: {ex.Message}";
        }
    }

    /// <summary>
    /// Formats a 6-digit code as "xxx xxx" for readability.
    /// </summary>
    private static string FormatCode(string code)
    {
        if (code.Length == 6)
        {
            return $"{code[..3]} {code[3..]}";
        }

        return code;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
