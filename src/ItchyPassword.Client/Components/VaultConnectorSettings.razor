@using ItchyPassword.Client.Services.VaultConnectors
@using System.Text.RegularExpressions

<div class="connector-settings grid-2">
    @if (Connector is not null)
    {
        @foreach (string key in Connector.Configuration.Keys)
        {
            string currentKey = key; // Capture for lambda.
            string val = Connector.Configuration[currentKey];
            bool isSecret = currentKey.Contains("token", StringComparison.OrdinalIgnoreCase) ||
                            currentKey.Contains("password", StringComparison.OrdinalIgnoreCase) ||
                            currentKey.Contains("secret", StringComparison.OrdinalIgnoreCase);

            <div class="form-group">
                <label>@SplitPascalCase(currentKey)</label>
                <input class="input"
                       type="@(isSecret ? "password" : "text")"
                       value="@val"
                       @onchange="@(e => UpdateValue(currentKey, e.Value?.ToString()))" />
            </div>
        }
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the vault connector instance to configure.
    /// </summary>
    [Parameter, EditorRequired]
    public IVaultConnector Connector { get; set; } = default!;

    /// <summary>
    /// Updates a configuration value and persists it immediately.
    /// Encryption of secrets is handled by the connector itself.
    /// </summary>
    private async Task UpdateValue(string key, string? val)
    {
        if (Connector is null || Connector.Configuration.ContainsKey(key) == false)
        {
            return;
        }

        Connector.Configuration[key] = val ?? string.Empty;
        await Connector.SaveConfigurationAsync();
    }

    /// <summary>
    /// Splits a PascalCase string into words separated by spaces.
    /// </summary>
    private static string SplitPascalCase(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        return Regex.Replace(text, "([a-z])([A-Z])", "$1 $2");
    }
}
