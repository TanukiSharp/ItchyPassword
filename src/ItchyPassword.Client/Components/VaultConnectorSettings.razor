@using ItchyPassword.Client.Services.VaultConnectors
@using ItchyPassword.Core.Models
@using ItchyPassword.Core.Services

<div class="connector-settings grid-2">
    @if (Connector is not null)
    {
        @foreach (ConfigurationEntry entry in Connector.Configuration)
        {
            // Conditional visibility: skip entries whose controlling value doesn't match.
            if (VaultConnectorHelper.IsEntryVisible(Connector.Configuration, entry) == false)
            {
                continue;
            }

            string currentValue = string.IsNullOrWhiteSpace(entry.Value) ? entry.DefaultValue : entry.Value;

            <div class="form-group">
                <label>@entry.Label</label>

                @if (entry.Kind == ConfigurationEntryKind.Dropdown)
                {
                    <select class="input"
                            value="@currentValue"
                            @onchange="@(e => UpdateValue(entry.Key, e.Value?.ToString()))">
                        @foreach (DropdownOption option in entry.Options)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                }
                else if (entry.Kind == ConfigurationEntryKind.ReadOnly)
                {
                    <input class="input" type="text" value="@currentValue" disabled />
                }
                else
                {
                    <input class="input @(GetValidationError(entry, currentValue) is not null ? "input-error" : "")"
                           type="@(entry.Kind == ConfigurationEntryKind.Secret ? "password" : "text")"
                           value="@currentValue"
                           placeholder="@entry.Placeholder"
                           @onchange="@(e => UpdateValue(entry.Key, e.Value?.ToString()))" />
                }

                @{ string? validationError = GetValidationError(entry, currentValue); }
                @if (validationError is not null)
                {
                    <span class="form-error">@validationError</span>
                }
                else if (string.IsNullOrWhiteSpace(entry.Description) == false)
                {
                    <span class="form-description">@entry.Description</span>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the vault connector instance to configure.
    /// </summary>
    [Parameter, EditorRequired]
    public IVaultConnector Connector { get; set; } = default!;

    /// <summary>
    /// Optional callback invoked before persisting any change to the connector
    /// configuration. When provided and returning false, the change is
    /// reverted (not persisted). Used by the parent to gate edits behind a
    /// master key re-entry when passkey unlock is enabled.
    /// </summary>
    [Parameter]
    public Func<Task<bool>>? AuthorizeChange { get; set; }

    /// <summary>
    /// Updates a configuration entry value and persists it immediately.
    /// Encryption of secrets is handled by the connector itself.
    /// </summary>
    private async Task UpdateValue(string key, string? val)
    {
        if (Connector is null)
        {
            return;
        }

        // Snapshot the previous value so we can detect a no-op and skip the prompt.
        string previousValue = VaultConnectorHelper.GetValue(Connector.Configuration, key);
        string newValue = val ?? string.Empty;

        if (string.Equals(previousValue, newValue, StringComparison.Ordinal))
        {
            return;
        }

        if (AuthorizeChange is not null)
        {
            bool authorized = await AuthorizeChange();
            if (authorized == false)
            {
                // Force a re-render so the input visibly reverts to the previous value.
                StateHasChanged();
                return;
            }
        }

        VaultConnectorHelper.SetValue(Connector.Configuration, key, newValue);
        await Connector.SaveConfigurationAsync(CancellationToken.None);
    }

    /// <summary>
    /// Returns a validation error message for the entry, or null when valid.
    /// </summary>
    private static string? GetValidationError(ConfigurationEntry entry, string value)
    {
        if (entry.Validate is null || string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return entry.Validate(value);
    }
}
