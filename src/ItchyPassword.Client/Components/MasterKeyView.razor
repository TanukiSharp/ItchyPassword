@using ItchyPassword.Client.Services
@using ItchyPassword.Core.Services
@inject VaultSession Session
@inject IAppState AppState
@inject NavigationManager Nav

<div @onclick="FocusMasterKeyAsync" class="master-key-overlay">
    <div class="master-key-panel">
        <h2>ItchyPassword</h2>

        <EditForm Model="this" OnValidSubmit="Submit">
            <div class="form-group">
                <label for="masterKey">Master Key</label>
                <div class="master-key-input-row">
                    <div class="master-key-input-wrapper">
                        <input @ref="_masterKeyInput" class="input master-key-input" type="@(_showPassword ? "text" : "password")" id="masterKey" @bind-value="masterKey" @bind-value:event="oninput" placeholder="Enter your master key" required autofocus />
                        <button type="button" class="master-key-toggle" @onclick="TogglePasswordVisibility" @onclick:stopPropagation title="@(_showPassword ? "Hide master key" : "Show master key")">
                            <img class="themed-icon" src="icons/@(_showPassword ? "eye-closed-dark" : "eye-open-dark").svg" width="18" height="18" alt="@(_showPassword ? "Hide" : "Show")" />
                        </button>
                    </div>
                    <span title="Character count" class="char-count">@masterKey.Length</span>
                </div>
            </div>

            <button class="button primary master-key-submit" type="submit" @onclick:stopPropagation>
                <span>Unlock</span>
            </button>
        </EditForm>
    </div>
</div>

@code {
    private string masterKey = string.Empty;
    private bool _showPassword = false;
    private ElementReference _masterKeyInput;

    protected override async Task OnInitializedAsync()
    {
        // Load the saved active reader preference from storage.
        await Session.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await FocusMasterKeyAsync();
    }

    private async Task FocusMasterKeyAsync()
    {
        await _masterKeyInput.FocusAsync();
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task Submit()
    {
        await AppState.UnlockAsync(System.Text.Encoding.UTF8.GetBytes(masterKey));
    }
}

