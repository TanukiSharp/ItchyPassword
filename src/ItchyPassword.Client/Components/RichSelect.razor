@namespace ItchyPassword.Client.Components
@typeparam TValue

<div class="rich-select @(isOpen ? "open" : "") @(Disabled ? "disabled" : "")">
    <button type="button"
            class="rich-select-trigger"
            disabled="@Disabled"
            @onclick="Toggle"
            @onclick:stopPropagation="true">
        <span class="rich-select-value">@SelectedLabel</span>
        <span class="rich-select-arrow">&#9662;</span>
    </button>

    @if (isOpen)
    {
        <div class="rich-select-backdrop" @onclick="Close"></div>
        <ul class="rich-select-list">
            @if (Options is not null)
            {
                @foreach (RichSelectOption<TValue> option in Options)
                {
                    bool isSelected = Equals(option.Value, Value);
                    <li class="rich-select-item @(option.Disabled ? "disabled" : "") @(isSelected ? "selected" : "")"
                        @onclick="@(() => SelectOption(option))">
                        <span class="rich-select-item-label">@option.Label</span>
                        @if (string.IsNullOrWhiteSpace(option.Hint) == false)
                        {
                            <span class="rich-select-item-hint">@option.Hint</span>
                        }
                    </li>
                }
            }
        </ul>
    }
</div>

@code {
    private bool isOpen;

    /// <summary>
    /// The currently selected value.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// Callback invoked when the user selects a new value.
    /// </summary>
    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>
    /// The list of options to display.
    /// </summary>
    [Parameter]
    public IReadOnlyList<RichSelectOption<TValue>>? Options { get; set; }

    /// <summary>
    /// Whether the entire dropdown is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    private string SelectedLabel
    {
        get
        {
            if (Options is not null && Value is not null)
            {
                RichSelectOption<TValue>? match = Options.FirstOrDefault(o => Equals(o.Value, Value));
                if (match is not null)
                {
                    return match.Label;
                }
            }

            return string.Empty;
        }
    }

    private void Toggle()
    {
        if (Disabled == false)
        {
            isOpen = !isOpen;
        }
    }

    private void Close()
    {
        isOpen = false;
    }

    private async Task SelectOption(RichSelectOption<TValue> option)
    {
        if (option.Disabled || Equals(option.Value, Value))
        {
            return;
        }

        isOpen = false;
        await ValueChanged.InvokeAsync(option.Value);
    }
}
