@inject ClipboardService Clipboard

<button class="button secondary @CssClass" type="button"
        @onclick="CopyAsync"
        disabled="@IsDisabled"
        title="@Tooltip">
    @if (_state == CopyState.Success)
    {
        <img src="icons/check.svg" width="16" height="16" alt="Success" />
    }
    else if (_state == CopyState.Error)
    {
        <img src="icons/error.svg" width="16" height="16" alt="Error" />
    }
    else
    {
        <img class="themed-icon" src="icons/copy-light.svg" width="16" height="16" alt="Copy" />
    }
</button>

@code {
    /// <summary>
    /// Static text to copy. Used when <see cref="TextProvider"/> is not set.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// Async function that produces the text to copy. Takes priority over <see cref="Text"/> when set.
    /// </summary>
    [Parameter]
    public Func<Task<string>>? TextProvider { get; set; }

    /// <summary>
    /// Optional additional CSS class(es) to apply to the button.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    private enum CopyState { Idle, Busy, Success, Error }
    private CopyState _state = CopyState.Idle;

    private bool IsDisabled => _state == CopyState.Busy
        || (TextProvider is null && string.IsNullOrWhiteSpace(Text));

    private string Tooltip => _state switch
    {
        CopyState.Success => "Copied!",
        CopyState.Error => "Failed to copy",
        CopyState.Busy => "Copying...",
        _ => "Copy to clipboard"
    };

    private async Task CopyAsync()
    {
        if (_state == CopyState.Busy)
        {
            return;
        }

        _state = CopyState.Busy;
        StateHasChanged();

        try
        {
            string text;

            if (TextProvider is not null)
            {
                text = await TextProvider();
            }
            else if (string.IsNullOrWhiteSpace(Text) == false)
            {
                text = Text;
            }
            else
            {
                return;
            }

            await Clipboard.CopyTextAsync(text);
            _state = CopyState.Success;
        }
        catch
        {
            _state = CopyState.Error;
        }

        StateHasChanged();
        await Task.Delay(2000);
        _state = CopyState.Idle;
        StateHasChanged();
    }
}
