@using ItchyPassword.Client.Services
@using ItchyPassword.Core.Services
@implements IItemEditor
@inject IVaultCryptoService VaultCrypto
@inject IMasterKeyProvider MasterKeyProvider
@inject RandomBytePool RandomPool

<div class="editor-column">

    @* ── Mode selector ── *@
    <div class="form-group">
        <label>Secret source</label>
        <div class="mode-selector">
            <label class="inline-label">
                <input type="radio" name="cipherMode" value="generate"
                       checked="@(_mode == CipherMode.Generate)"
                       @onchange="@(() => SetMode(CipherMode.Generate))" />
                Generate from rules
            </label>
            <label class="inline-label">
                <input type="radio" name="cipherMode" value="manual"
                       checked="@(_mode == CipherMode.Manual)"
                       @onchange="@(() => SetMode(CipherMode.Manual))" />
                Enter manually
            </label>
        </div>
    </div>

    @* ── Rule-based generation ── *@
    @if (_mode == CipherMode.Generate)
    {
        <div class="grid-3col">
            <div class="form-group">
                <label>Min Lowercase</label>
                <input class="input" type="number" min="0" @bind="_rules.MinLowercase" />
            </div>
            <div class="form-group">
                <label>Min Uppercase</label>
                <input class="input" type="number" min="0" @bind="_rules.MinUppercase" />
            </div>
            <div class="form-group">
                <label>Min Digits</label>
                <input class="input" type="number" min="0" @bind="_rules.MinDigits" />
            </div>
            <div class="form-group">
                <label>Min Symbols</label>
                <input class="input" type="number" min="0" @bind="_rules.MinSymbols" />
            </div>
            <div class="form-group">
                <label>Symbol alphabet</label>
                <div class="symbol-input-group">
                    <input class="input" type="text" @bind="_rules.SymbolAlphabet" />
                    <button type="button" class="button secondary symbol-reset-btn"
                            @onclick="ResetSymbolAlphabet" title="Reset to default alphabet">↺</button>
                </div>
            </div>
            <div class="form-group">
                <label>Total Length</label>
                <input class="input" type="number" min="1" @bind="_rules.TotalLength" />
            </div>
        </div>

        <button type="button" class="button primary button-block" @onclick="GenerateSecretAsync" disabled="@_isBusy">
            Generate Secret
        </button>
    }

    @* ── Plaintext secret (input, generated result, or decrypted value) ── *@
    <div class="form-group">
        <label>Secret (plaintext)</label>
        <div class="input-with-action">
            <textarea class="input secret-textarea" rows="3" @bind="_plaintext" @bind:event="oninput"
                      placeholder="Enter your secret here…"></textarea>
            <CopyButton Text="@_plaintext" />
        </div>
    </div>

    @* ── Status / Error messages ── *@
    @if (string.IsNullOrWhiteSpace(_statusMessage) == false)
    {
        <div class="alert @_statusClass">@_statusMessage</div>
    }
</div>

@code {
    private const string DefaultEncoding = "base58";
    private const int DefaultVersion = 3;

    [Parameter]
    public required VaultItemV2 Item { get; init; }

    private enum CipherMode { Manual, Generate }

    private CipherMode _mode = CipherMode.Generate;
    private string _plaintext = string.Empty;
    private bool _isBusy;
    private string _busyAction = string.Empty;
    private string _statusMessage = string.Empty;
    private string _statusClass = string.Empty;

    private readonly SecretGenerationRules _rules = new();

    protected override async Task OnInitializedAsync()
    {
        // Auto-decrypt existing content when editing an item.
        if (Item.SecretData is not null && string.IsNullOrWhiteSpace(Item.SecretData.Cipher) == false)
        {
            await DecryptContentAsync();
        }
    }

    private void SetMode(CipherMode mode)
    {
        _mode = mode;
        _statusMessage = string.Empty;
    }

    private void ResetSymbolAlphabet()
    {
        _rules.SymbolAlphabet = SecretGenerationRules.DefaultSymbolAlphabet;
    }

    private async Task GenerateSecretAsync()
    {
        _statusMessage = string.Empty;

        if (_rules.IsValid(out string? error) == false)
        {
            ShowError(error ?? "Invalid generation rules.");
            return;
        }

        _isBusy = true;
        _busyAction = "generate";

        try
        {
            _plaintext = await SecretGenerator.GenerateAsync(_rules, RandomPool);
        }
        catch (Exception ex)
        {
            ShowError($"Generation failed: {ex.Message}");
        }
        finally
        {
            _isBusy = false;
            _busyAction = string.Empty;
        }
    }

    /// <summary>
    /// Encrypts the current plaintext and stores the result in Item.Content.
    /// Called by the parent view before saving to the vault.
    /// </summary>
    public async Task<bool> PrepareForSaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_plaintext))
        {
            ShowError("Nothing to encrypt. Enter or generate a secret first.");
            return false;
        }

        if (MasterKeyProvider.HasMasterKey == false)
        {
            ShowError("Master key is not available.");
            return false;
        }

        _isBusy = true;
        _busyAction = "encrypt";
        _statusMessage = string.Empty;

        try
        {
            string encoding = Item.SecretData?.Encoding ?? DefaultEncoding;
            SecretDataV2 secretData = await VaultCrypto.EncryptSecretAsync(_plaintext, MasterKeyProvider.MasterKey, encoding);
            Item.SetData(secretData);
            return true;
        }
        catch (Exception ex)
        {
            ShowError($"Encryption failed: {ex.Message}");
            return false;
        }
        finally
        {
            _isBusy = false;
            _busyAction = string.Empty;
        }
    }

    private async Task DecryptContentAsync()
    {
        if (Item.SecretData is null || string.IsNullOrWhiteSpace(Item.SecretData.Cipher))
        {
            return;
        }

        if (MasterKeyProvider.HasMasterKey == false)
        {
            ShowError("Master key is not available.");
            return;
        }

        _isBusy = true;
        _busyAction = "decrypt";
        _statusMessage = string.Empty;

        try
        {
            _plaintext = await VaultCrypto.DecryptSecretAsync(Item.SecretData!, MasterKeyProvider.MasterKey);
        }
        catch (FormatException)
        {
            ShowError("Stored content could not be decoded. It may be corrupted.");
        }
        catch (Exception ex)
        {
            ShowError($"Decryption failed: {ex.Message}");
        }
        finally
        {
            _isBusy = false;
            _busyAction = string.Empty;
        }
    }

    private void ShowError(string message)
    {
        _statusMessage = message;
        _statusClass = "danger";
    }
}
