@using ItchyPassword.Client.Services
@using ItchyPassword.Core.Constants
@using ItchyPassword.Core.Services
@implements IItemEditor
@inject IVaultCryptoService VaultCrypto
@inject IMasterKeyProvider MasterKeyProvider
@inject RandomBytePool RandomPool

<div class="editor-column">

    @* ── Rule-based generation ── *@
    <details>
        <summary class="details-summary">Generation rules</summary>
        <div class="options-panel">
            <div class="grid-3col">
                <div class="form-group">
                    <label>Min Lowercase</label>
                    <input class="input" type="number" min="0" @bind="_rules.MinLowercase" />
                </div>
                <div class="form-group">
                    <label>Min Uppercase</label>
                    <input class="input" type="number" min="0" @bind="_rules.MinUppercase" />
                </div>
                <div class="form-group">
                    <label>Min Digits</label>
                    <input class="input" type="number" min="0" @bind="_rules.MinDigits" />
                </div>
                <div class="form-group">
                    <label>Min Symbols</label>
                    <input class="input" type="number" min="0" @bind="_rules.MinSymbols" />
                </div>
                <div class="form-group">
                    <label>Symbol alphabet</label>
                    <div class="symbol-input-group">
                        <input class="input @(_hasSymbolDuplicates ? "input-warning" : string.Empty)" type="text"
                               value="@_rules.SymbolAlphabet" @oninput="OnSymbolAlphabetInput" />
                        <button type="button" class="button secondary symbol-reset-btn"
                                @onclick="ResetSymbolAlphabet" title="Reset to default alphabet">↺</button>
                    </div>
                    @if (_hasSymbolDuplicates)
                    {
                        <div class="alphabet-warning">
                            <span class="alert-inline-warning">Duplicate characters: @_symbolDuplicatesSummary</span>
                            <button type="button" class="button secondary button-sm" @onclick="DeduplicateSymbolAlphabet"
                                    title="Remove duplicate characters from the alphabet.">
                                Remove duplicates
                            </button>
                        </div>
                    }
                </div>
                <div class="form-group">
                    <label>Total Length</label>
                    <input class="input" type="number" min="1" @bind="_rules.TotalLength" />
                </div>
            </div>

            <button type="button" class="button primary" @onclick="GenerateSecretAsync" disabled="@_isBusy">
                Generate Secret
            </button>
        </div>
    </details>

    @* ── Secret viewer (dropdown label selects display mode) ── *@
    <div class="form-group">

        @if (_isBusy && _busyAction == "decrypt")
        {
            <div class="secret-label-row">
                <label>Secret </label>
                <select class="input label-select" value="@_viewMode" @onchange="OnViewModeChanged">
                    <option value="plaintext">Plaintext</option>
                    <option value="totp">2FA / TOTP</option>
                    <option value="qrcode">QR Code</option>
                </select>
            </div>
            <div class="inline-loading">
                <div class="loading-spinner-sm"></div>
                <span class="text-muted">Decrypting…</span>
            </div>
        }
        else if (_viewMode == "plaintext")
        {
            <div class="secret-plaintext-grid">
                <div class="secret-header-row">
                    <div class="secret-label-row">
                        <label>Secret </label>
                        <select class="input label-select" value="@_viewMode" @onchange="OnViewModeChanged">
                            <option value="plaintext">Plaintext</option>
                            <option value="totp">2FA / TOTP</option>
                            <option value="qrcode">QR Code</option>
                        </select>
                    </div>
                    <span class="secret-byte-count text-muted">@ByteSizeFormat.ToHumanReadable(_plaintext.Length)</span>
                </div>
                <textarea class="input secret-textarea" rows="3" @bind="_plaintext" @bind:event="oninput"
                          placeholder="Enter your secret here…"></textarea>
                <CopyButton Text="@_plaintext" />
            </div>
        }
        else
        {
            <div class="secret-label-row">
                <label>Secret </label>
                <select class="input label-select" value="@_viewMode" @onchange="OnViewModeChanged">
                    <option value="plaintext">Plaintext</option>
                    <option value="totp">2FA / TOTP</option>
                    <option value="qrcode">QR Code</option>
                </select>
            </div>

            if (_viewMode == "totp")
            {
                <TotpDisplay Secret="@_plaintext" />
            }
            else if (_viewMode == "qrcode")
            {
                <QrCodeDisplay Text="@_plaintext" />
            }
        }
    </div>

    @* ── Status / Error messages ── *@
    @if (string.IsNullOrWhiteSpace(_statusMessage) == false)
    {
        <div class="alert @_statusClass">@_statusMessage</div>
    }
</div>

@code {
    [Parameter]
    public required VaultItemV2 Item { get; init; }

    private string _plaintext = string.Empty;
    private string _viewMode = "plaintext";
    private bool _isBusy;
    private string _busyAction = string.Empty;
    private string _statusMessage = string.Empty;
    private string _statusClass = string.Empty;

    private readonly SecretGenerationRules _rules = new();
    private bool _hasSymbolDuplicates;
    private string _symbolDuplicatesSummary = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Auto-decrypt existing content when editing an item.
        if (Item.SecretData is not null && string.IsNullOrWhiteSpace(Item.SecretData.Value.Cipher) == false)
        {
            await DecryptContentAsync();
        }
    }

    private void OnViewModeChanged(ChangeEventArgs e)
    {
        _viewMode = e.Value?.ToString() ?? "plaintext";
    }

    private void OnSymbolAlphabetInput(ChangeEventArgs e)
    {
        _rules.SymbolAlphabet = e.Value?.ToString() ?? string.Empty;
        UpdateSymbolAlphabetValidation();
    }

    private void ResetSymbolAlphabet()
    {
        _rules.SymbolAlphabet = SecretDataConstants.DefaultSymbolAlphabet;
        UpdateSymbolAlphabetValidation();
    }

    private void UpdateSymbolAlphabetValidation()
    {
        var duplicates = AlphabetValidator.FindDuplicates(_rules.SymbolAlphabet);
        _hasSymbolDuplicates = duplicates.Count > 0;
        _symbolDuplicatesSummary = _hasSymbolDuplicates
            ? string.Join(", ", duplicates.Select(kv => $"'{kv.Key}' ({kv.Value}x)"))
            : string.Empty;
    }

    private void DeduplicateSymbolAlphabet()
    {
        _rules.SymbolAlphabet = AlphabetValidator.Deduplicate(_rules.SymbolAlphabet);
        UpdateSymbolAlphabetValidation();
    }

    private async Task GenerateSecretAsync()
    {
        _statusMessage = string.Empty;

        if (_rules.IsValid(out string? error) == false)
        {
            ShowError(error ?? "Invalid generation rules.");
            return;
        }

        _isBusy = true;
        _busyAction = "generate";

        try
        {
            _plaintext = await SecretGenerator.GenerateAsync(_rules, RandomPool, CancellationToken.None);
        }
        catch (Exception ex)
        {
            ShowError($"Generation failed: {ex.Message}");
        }
        finally
        {
            _isBusy = false;
            _busyAction = string.Empty;
        }
    }

    /// <summary>
    /// Encrypts the current plaintext and stores the result in Item.Content.
    /// Called by the parent view before saving to the vault.
    /// </summary>
    public async Task<bool> PrepareForSaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_plaintext))
        {
            ShowError("Nothing to encrypt. Enter or generate a secret first.");
            return false;
        }

        if (MasterKeyProvider.HasMasterKey == false)
        {
            ShowError("Master key is not available.");
            return false;
        }

        _isBusy = true;
        _busyAction = "encrypt";
        _statusMessage = string.Empty;

        try
        {
            string encoding = Item.SecretData?.Encoding ?? SecretDataConstants.LatestEncoding;
            SecretDataV2 secretData = await VaultCrypto.EncryptSecretAsync(_plaintext, MasterKeyProvider.MasterKey, encoding, CancellationToken.None);
            Item.SetData(secretData);
            return true;
        }
        catch (Exception ex)
        {
            ShowError($"Encryption failed: {ex.Message}");
            return false;
        }
        finally
        {
            _isBusy = false;
            _busyAction = string.Empty;
        }
    }

    private async Task DecryptContentAsync()
    {
        if (Item.SecretData is null || string.IsNullOrWhiteSpace(Item.SecretData.Value.Cipher))
        {
            return;
        }

        if (MasterKeyProvider.HasMasterKey == false)
        {
            ShowError("Master key is not available.");
            return;
        }

        _isBusy = true;
        _busyAction = "decrypt";
        _statusMessage = string.Empty;

        await Task.Yield(); // Allow UI to render before starting decryption.

        try
        {
            _plaintext = await VaultCrypto.DecryptSecretAsync(Item.SecretData!.Value, MasterKeyProvider.MasterKey, CancellationToken.None);
        }
        catch (FormatException)
        {
            ShowError("Stored content could not be decoded. It may be corrupted.");
        }
        catch (Exception ex)
        {
            ShowError($"Decryption failed: {ex.Message}");
        }
        finally
        {
            _isBusy = false;
            _busyAction = string.Empty;
        }
    }

    private void ShowError(string message)
    {
        _statusMessage = message;
        _statusClass = "danger";
    }
}
