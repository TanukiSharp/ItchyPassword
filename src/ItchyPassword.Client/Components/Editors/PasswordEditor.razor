@using ItchyPassword.Client.Services
@using ItchyPassword.Core.Extensions;
@inject ICryptoService Crypto
@inject ClipboardService Clipboard

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
    <div>
        <div class="form-group">
            <label>Public Salt</label>
            <input class="input" @bind="publicSalt" />
        </div>

        <div class="form-group">
            <label>Alphabet</label>
            <input class="input" @bind="alphabet" />
        </div>

        <div class="form-group">
            <label>Length</label>
            <input class="input" type="number" @bind="length" />
        </div>

        <button type="button" class="button primary" style="width: 100%;" @onclick="GenerateAsync" disabled="@isGenerating">
            Generate Password
        </button>
    </div>

    <div>
        <div class="form-group">
            <label>Result</label>
            <div style="display: flex; gap: 0.5rem;">
                <input class="input" type="text" readonly value="@result" style="flex: 1;" />
                <button class="button secondary" type="button" @onclick="CopyAsync">Copy</button>
            </div>
            <small style="color: var(--text-muted); display: block; margin-top: 0.5rem;">Calculated output.</small>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public required VaultItem Item { get; init; }

    [Parameter]
    public string MasterKey { get; set; } = "";

    private string publicSalt = "";
    private string alphabet = "";
    private int length;
    private string result = "";
    private bool isGenerating = false;

    private const int DefaultLength = 64;

    protected override void OnInitialized()
    {
        publicSalt = Item.Parameters?.GetStringValueOrDefault("public", string.Empty) ?? string.Empty;
        alphabet = Item.Parameters?.GetStringValueOrDefault("alphabet", string.Empty) ?? string.Empty;
        length = Item.Parameters?.GetIntegerValueOrDefault("length", DefaultLength) ?? DefaultLength;
    }

    private async Task GenerateAsync()
    {
        isGenerating = true;

        try
        {
            // Update item params
            Item.Parameters["public"] = publicSalt;
            Item.Parameters["alphabet"] = alphabet;
            Item.Parameters["length"] = length;

            // 1. Generate Raw Hash (Using V2 generator)
            // Use MasterKey (private) and Salt (public).
            byte[] rawBytes = await Crypto.GeneratePasswordV2Async(
                System.Text.Encoding.UTF8.GetBytes(MasterKey),
                System.Text.Encoding.UTF8.GetBytes(publicSalt)
            );

            if (string.IsNullOrWhiteSpace(alphabet))
            {
                result = Base58.Encode(rawBytes);
            }
            else
            {
                // Using OneWay encoding to match legacy implementation.
                result = BaseN.EncodeOneWay(rawBytes, alphabet);
            }

            if (result.Length > length)
            {
                result = result.Substring(0, length);
            }
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task CopyAsync()
    {
        if (string.IsNullOrWhiteSpace(result) == false)
        {
             await Clipboard.CopyTextAsync(result);
        }
    }
}
