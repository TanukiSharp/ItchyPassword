@using ItchyPassword.Client.Services
@using ItchyPassword.Core.Constants
@using ItchyPassword.Core.Services
@implements IItemEditor
@implements IDisposable
@inject IVaultCryptoService VaultCrypto
@inject IMasterKeyProvider MasterKeyProvider

<div class="grid-2col">
    <div class="form-group">
        <label>Public Part</label>
        <div class="input-with-action">
            <input class="input" value="@_publicPart" @oninput="OnPublicPartInput" minlength="@MinPublicPartLength" placeholder="@($"At least {MinPublicPartLength} characters")" />
        </div>
    </div>

    <div class="form-group">
        <label>Result</label>
        <div class="input-with-action">
            <input class="input" type="text" readonly value="@_result" />
            <CopyButton Text="@_result" />
        </div>
    </div>
</div>

<details class="static-key-advanced">
    <summary class="details-summary">Advanced options</summary>
    <div class="options-panel">
        <div class="grid-2col">
            <div class="form-group">
                <label>Alphabet</label>
                <div class="symbol-input-group">
                    <input class="input @(_hasDuplicateChars ? "input-warning" : string.Empty)" value="@_alphabet" @oninput="OnAlphabetInput" />
                    <button type="button" class="button secondary symbol-reset-btn"
                            @onclick="ResetAlphabet" title="Reset to default alphabet">↺</button>
                </div>
                @if (_hasDuplicateChars)
                {
                    <div class="alphabet-warning">
                        <span class="alert-inline-warning">Duplicate characters detected: @_duplicateCharsSummary</span>
                        <button type="button" class="button secondary button-sm" @onclick="DeduplicateAlphabet" title="Remove duplicate characters from the alphabet.">
                            Remove duplicates
                        </button>
                    </div>
                }
            </div>

            <div class="form-group">
                <label>Length</label>
                <input class="input" type="number" min="@MinLength" value="@_length" @oninput="OnLengthInput" />
            </div>

            <div class="form-group">
                <label>Crypto version</label>
                <select class="input" value="@_cryptoVersion" @onchange="OnCryptoVersionChanged">
                    <option value="2">v2</option>
                    <option value="1">v1 (Legacy)</option>
                </select>
            </div>

            <div class="form-group">
                <label>Encoding version</label>
                <select class="input" value="@_encodingVersion" @onchange="OnEncodingVersionChanged">
                    <option value="2">v2</option>
                    <option value="1">v1 (Legacy)</option>
                </select>
            </div>
        </div>
    </div>
</details>

@if (string.IsNullOrWhiteSpace(_error) == false)
{
    <div class="alert danger alert-inline-sm">@_error</div>
}

@code {
    [Parameter]
    public VaultItemV2? Item { get; init; }

    private string _publicPart = string.Empty;
    private string _alphabet = StaticKeyDataConstants.DefaultAlphabet;
    private int _length = StaticKeyDataConstants.DefaultLength;
    private int _cryptoVersion = StaticKeyDataConstants.LatestCryptoVersion;
    private int _encodingVersion = StaticKeyDataConstants.LatestEncodingVersion;

    private readonly Debouncer _debouncer = new();
    private string _result = string.Empty;
    private string _error = string.Empty;

    private bool _hasDuplicateChars = false;
    private string _duplicateCharsSummary = string.Empty;

    private const int MinPublicPartLength = 8;
    private const int MinLength = 8;

    protected override async Task OnInitializedAsync()
    {
        if (Item?.StaticKeyData is { } parameters)
        {
            _publicPart = parameters.PublicPart;
            _encodingVersion = parameters.EncodingVersion;
            _length = parameters.Length;
            _cryptoVersion = parameters.CryptoVersion;

            if (string.IsNullOrEmpty(parameters.Alphabet) == false)
            {
                _alphabet = parameters.Alphabet;
            }
        }

        UpdateAlphabetValidation();

        // Auto-generate if editing an existing item with a public part.
        if (string.IsNullOrWhiteSpace(_publicPart) == false)
        {
            await GenerateAsync();
        }
    }

    /// <summary>
    /// Checks the alphabet for duplicate characters and updates the warning state.
    /// </summary>
    private void UpdateAlphabetValidation()
    {
        var duplicates = AlphabetValidator.FindDuplicates(_alphabet);
        _hasDuplicateChars = duplicates.Count > 0;

        if (_hasDuplicateChars)
        {
            _duplicateCharsSummary = string.Join(", ", duplicates.Select(kv => $"'{kv.Key}' ({kv.Value}x)"));
        }
        else
        {
            _duplicateCharsSummary = string.Empty;
        }
    }

    /// <summary>
    /// Resets the alphabet to the default value and re-generates if possible.
    /// </summary>
    private async Task ResetAlphabet()
    {
        _alphabet = StaticKeyDataConstants.DefaultAlphabet;
        UpdateAlphabetValidation();
        await TryAutoGenerateAsync();
    }

    /// <summary>
    /// Removes duplicate characters from the alphabet and re-generates if possible.
    /// </summary>
    private async Task DeduplicateAlphabet()
    {
        _alphabet = AlphabetValidator.Deduplicate(_alphabet);
        UpdateAlphabetValidation();
        await TryAutoGenerateAsync();
    }

    private async Task GenerateAsync(bool debounce = false)
    {
        if (debounce)
        {
            if (await _debouncer.IsBouncedAsync())
            {
                return;
            }
        }

        try
        {
            var data = new StaticKeyDataV2
            {
                PublicPart = _publicPart,
                Alphabet = _alphabet,
                Length = _length,
                CryptoVersion = _cryptoVersion,
                EncodingVersion = _encodingVersion,
            };

            _result = await VaultCrypto.GenerateStaticKeyAsync(data, MasterKeyProvider.MasterKey, CancellationToken.None);

            // Sync updated config to the item when editing a vault entry.
            Item?.SetData(data);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>
    /// Validates inputs and generates the password, storing data on the item.
    /// Called by the parent view before saving to the vault.
    /// </summary>
    public async Task<bool> PrepareForSaveAsync()
    {
        _error = string.Empty;

        if (_publicPart.Length < MinPublicPartLength)
        {
            _error = $"Public part must be at least {MinPublicPartLength} characters.";
            return false;
        }

        if (_length < MinLength)
        {
            _error = $"Length must be at least {MinLength}.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_alphabet) || _alphabet.Length < 2)
        {
            _error = "Alphabet must contain at least 2 characters for legacy encoding.";
            return false;
        }

        await GenerateAsync();

        return true;
    }

    private async Task OnCryptoVersionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cryptoVersion) == false)
        {
            cryptoVersion = StaticKeyDataConstants.LatestCryptoVersion;
        }
        _cryptoVersion = cryptoVersion;
        await TryAutoGenerateAsync();
    }

    private async Task OnEncodingVersionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int encodingVersion) == false)
        {
            encodingVersion = StaticKeyDataConstants.LatestEncodingVersion;
        }
        _encodingVersion = encodingVersion;
        await TryAutoGenerateAsync();
    }

    private async Task OnPublicPartInput(ChangeEventArgs e)
    {
        _publicPart = e.Value?.ToString() ?? string.Empty;
        await TryAutoGenerateAsync();
    }

    private async Task OnAlphabetInput(ChangeEventArgs e)
    {
        _alphabet = e.Value?.ToString() ?? string.Empty;
        UpdateAlphabetValidation();
        await TryAutoGenerateAsync();
    }

    private async Task OnLengthInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            _length = val;
            await TryAutoGenerateAsync();
        }
    }

    /// <summary>
    /// Generates automatically if the minimum input requirements are met, otherwise clears the result.
    /// </summary>
    private async Task TryAutoGenerateAsync()
    {
        if (_publicPart.Length >= MinPublicPartLength && _length >= MinLength && _alphabet.Length >= 2)
        {
            _result = string.Empty;
            await GenerateAsync(debounce: true);
        }
        else
        {
            _debouncer.Cancel();
            _result = string.Empty;
        }
    }

    public void Dispose()
    {
        _debouncer.Dispose();
    }
}
