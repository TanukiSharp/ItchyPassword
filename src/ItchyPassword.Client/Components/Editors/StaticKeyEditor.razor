@using ItchyPassword.Client.Services
@implements IItemEditor
@inject ICryptoService Crypto
@inject ClientVaultState State

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
    <div>
        <div class="form-group">
            <label>Public Salt</label>
            <input class="input" value="@_publicPart" @oninput="OnPublicPartInput" minlength="@MinPublicSaltLength" placeholder="@($"At least {MinPublicSaltLength} characters")" />
        </div>

        <div class="form-group">
            <label>Alphabet</label>
            <input class="input" value="@_alphabet" @oninput="OnAlphabetInput" />
        </div>

        <div class="form-group">
            <label>Length</label>
            <input class="input" type="number" min="@MinLength" value="@_length" @oninput="OnLengthInput" />
        </div>

        <div class="form-group">
            <label>Crypto version</label>
            <select class="input" value="@_cryptoVersion" @onchange="OnCryptoVersionChanged">
                <option value="2">v2</option>
                <option value="1">v1 (Legacy)</option>
            </select>
        </div>

        <div class="form-group">
            <label>Encoding version</label>
            <select class="input" value="@_encodingVersion" @onchange="OnEncodingVersionChanged">
                <option value="2">v2</option>
                <option value="1">v1 (Legacy)</option>
            </select>
        </div>

        <button type="button" class="button primary" style="width: 100%;" @onclick="GenerateAsync" disabled="@(_isGenerating || _publicPart.Length < MinPublicSaltLength || _length < MinLength)">
            Generate Password
        </button>

        @if (string.IsNullOrWhiteSpace(_error) == false)
        {
            <div class="alert danger" style="margin-top: 0.5rem;">@_error</div>
        }
    </div>

    <div>
        <div class="form-group">
            <label>Result</label>
            <div style="display: flex; gap: 0.5rem; align-items: start;">
                <input class="input" type="text" readonly value="@_result" style="flex: 1; margin-bottom: 0; min-height: 2.5rem;" />
                <CopyButton Text="@_result" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public required VaultItemV2 Item { get; init; }

    private string _publicPart = string.Empty;
    private string _alphabet = VaultMigrationService.DefaultAlphabet;
    private int _length = DefaultLength;
    private int _cryptoVersion = 2;
    private int _encodingVersion = 2;

    private string _result = string.Empty;
    private bool _isGenerating = false;
    private string _error = string.Empty;

    private const int MinPublicSaltLength = 8;
    private const int MinLength = 8;
    private const int DefaultLength = 64;

    protected override async Task OnInitializedAsync()
    {
        // TODO: This is always set.
        if (Item.StaticKeyData is StaticKeyDataV2 parameters)
        {
            _publicPart = parameters.PublicPart;
            _encodingVersion = parameters.EncodingVersion;

            if (string.IsNullOrEmpty(parameters.Alphabet) == false)
            {
                _alphabet = VaultMigrationService.DefaultAlphabet;
            }

            _length = parameters.Length;
            _cryptoVersion = parameters.CryptoVersion;
        }
        else
        {
            _publicPart = string.Empty;
            _encodingVersion = 2;
            _alphabet = VaultMigrationService.DefaultAlphabet;
            _length = DefaultLength;
            _cryptoVersion = 2;
        }

        // Auto-generate if editing an existing item with a public part.
        if (string.IsNullOrWhiteSpace(_publicPart) == false)
        {
            await GenerateAsync();
        }
    }

    private async Task GenerateAsync()
    {
        _isGenerating = true;

        try
        {
            byte[] rawBytes;

            if (_cryptoVersion == 1)
            {
                rawBytes = await Crypto.GeneratePasswordV1Async(
                    System.Text.Encoding.UTF8.GetBytes(State.MasterKey),
                    System.Text.Encoding.UTF8.GetBytes(_publicPart)
                );
            }
            else if (_cryptoVersion == 2)
            {
                rawBytes = await Crypto.GeneratePasswordV2Async(
                    System.Text.Encoding.UTF8.GetBytes(State.MasterKey),
                    System.Text.Encoding.UTF8.GetBytes(_publicPart)
                );
            }
            else
            {
                throw new InvalidOperationException($"Unsupported crypto version: {_cryptoVersion}.");
            }

            if (_encodingVersion == 1)
            {
                _result = BaseN.EncodeOneWay(rawBytes, _alphabet);
            }
            else if (_encodingVersion == 2)
            {
                _result = BaseN.Encode(rawBytes, _alphabet);
            }
            else
            {
                throw new InvalidOperationException($"Unsupported encoding version: {_encodingVersion}.");
            }

            if (_result.Length > _length)
            {
                _result = _result.Substring(0, _length);
            }

            Item.SetData(new StaticKeyDataV2
            {
                PublicPart = _publicPart,
                Alphabet = _alphabet,
                Length = _length,
                CryptoVersion = _cryptoVersion,
                EncodingVersion = _encodingVersion,
            });
        }
        finally
        {
            _isGenerating = false;
        }
    }

    /// <summary>
    /// Validates inputs and generates the password, storing data on the item.
    /// Called by the parent view before saving to the vault.
    /// </summary>
    public async Task<bool> PrepareForSaveAsync()
    {
        _error = string.Empty;

        if (_publicPart.Length < MinPublicSaltLength)
        {
            _error = $"Public salt must be at least {MinPublicSaltLength} characters.";
            return false;
        }

        if (_length < MinLength)
        {
            _error = $"Length must be at least {MinLength}.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_alphabet) || _alphabet.Length < 2)
        {
            _error = "Alphabet must contain at least 2 characters for legacy encoding.";
            return false;
        }

        await GenerateAsync();

        return true;
    }

    private async Task OnCryptoVersionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cryptoVersion) == false)
        {
            cryptoVersion = 2;
        }
        _cryptoVersion = cryptoVersion;
        _result = string.Empty;
        await TryAutoGenerateAsync();
    }

    private async Task OnEncodingVersionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int encodingVersion) == false)
        {
            encodingVersion = 2;
        }
        _encodingVersion = encodingVersion;
        _result = string.Empty;
        await TryAutoGenerateAsync();
    }

    private async Task OnPublicPartInput(ChangeEventArgs e)
    {
        _publicPart = e.Value?.ToString() ?? string.Empty;
        await TryAutoGenerateAsync();
    }

    private async Task OnAlphabetInput(ChangeEventArgs e)
    {
        _alphabet = e.Value?.ToString() ?? string.Empty;
        await TryAutoGenerateAsync();
    }

    private async Task OnLengthInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            _length = val;
            await TryAutoGenerateAsync();
        }
    }

    /// <summary>
    /// Generates automatically if the minimum input requirements are met, otherwise clears the result.
    /// </summary>
    private async Task TryAutoGenerateAsync()
    {
        if (_publicPart.Length >= MinPublicSaltLength && _length >= MinLength && _alphabet.Length >= 2)
        {
            await GenerateAsync();
        }
        else
        {
            _result = string.Empty;
        }
    }
}
