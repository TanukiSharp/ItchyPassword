@using ItchyPassword.Client.Services
@implements IItemEditor
@inject ICryptoService Crypto
@inject ClientVaultState State

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
    <div>
        <div class="form-group">
            <label>Public Salt</label>
            <input class="input" @bind="_publicPart" @bind:event="oninput" minlength="@MinPublicSaltLength" placeholder="@($"At least {MinPublicSaltLength} characters")" />
        </div>

        <div class="form-group">
            <label>Alphabet</label>
            <input class="input" @bind="_alphabet" @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label>Length</label>
            <input class="input" type="number" min="@MinLength" @bind="_length" @bind:event="oninput" />
        </div>

        <button type="button" class="button primary" style="width: 100%;" @onclick="GenerateAsync" disabled="@(_isGenerating || _publicPart.Length < MinPublicSaltLength || _length < MinLength)">
            Generate Password
        </button>

        @if (string.IsNullOrWhiteSpace(_error) == false)
        {
            <div class="alert danger" style="margin-top: 0.5rem;">@_error</div>
        }
    </div>

    <div>
        <div class="form-group">
            <label>Result</label>
            <div style="display: flex; gap: 0.5rem; align-items: start;">
                <input class="input" type="text" readonly value="@_result" style="flex: 1; margin-bottom: 0; min-height: 2.5rem;" />
                <CopyButton Text="@_result" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public required VaultItemV2 Item { get; init; }

    private string _publicPart = string.Empty;
    private string _alphabet = VaultMigrationService.DefaultAlphabet;
    private int _length;
    private int _cipherVersion;
    private string _result = string.Empty;
    private bool _isGenerating = false;
    private string _error = string.Empty;

    private const int MinPublicSaltLength = 8;
    private const int MinLength = 8;
    private const int DefaultLength = 64;

    protected override async Task OnInitializedAsync()
    {
        StaticKeyDataV2 parameters = Item.StaticKeyData ?? new StaticKeyDataV2();

        _publicPart = parameters.PublicPart;
        if (string.IsNullOrEmpty(parameters.Alphabet) == false)
        {
            _alphabet = parameters.Alphabet;
        }
        _length = parameters.Length;
        _cipherVersion = parameters.CryptoVersion;

        // Auto-generate if editing an existing item with a public part.
        if (string.IsNullOrWhiteSpace(_publicPart) == false)
        {
            await GenerateAsync();
        }
    }

    private async Task GenerateAsync()
    {
        _isGenerating = true;

        try
        {
            byte[] rawBytes;

            if (_cipherVersion == 1)
            {
                rawBytes = await Crypto.GeneratePasswordV1Async(
                    System.Text.Encoding.UTF8.GetBytes(State.MasterKey),
                    System.Text.Encoding.UTF8.GetBytes(_publicPart)
                );
            }
            else if (_cipherVersion == 2)
            {
                rawBytes = await Crypto.GeneratePasswordV2Async(
                    System.Text.Encoding.UTF8.GetBytes(State.MasterKey),
                    System.Text.Encoding.UTF8.GetBytes(_publicPart)
                );
            }
            else
            {
                throw new InvalidOperationException($"Unsupported cipher version: {_cipherVersion}.");
            }

            string encoding;

            if (string.IsNullOrWhiteSpace(_alphabet))
            {
                _result = Base58.Encode(rawBytes);
                encoding = "base58";
            }
            else
            {
                // Using OneWay encoding to match legacy implementation.
                _result = BaseN.EncodeOneWay(rawBytes, _alphabet);
                encoding = "legacy";
            }

            if (_result.Length > _length)
            {
                _result = _result.Substring(0, _length);
            }

            Item.SetData(new StaticKeyDataV2
            {
                PublicPart = _publicPart,
                Alphabet = _alphabet,
                Length = _length,
                CryptoVersion = _cipherVersion,
                Encoding = encoding
            });
        }
        finally
        {
            _isGenerating = false;
        }
    }

    /// <summary>
    /// Validates inputs and generates the password, storing data on the item.
    /// Called by the parent view before saving to the vault.
    /// </summary>
    public async Task<bool> PrepareForSaveAsync()
    {
        _error = string.Empty;

        if (_publicPart.Length < MinPublicSaltLength)
        {
            _error = $"Public salt must be at least {MinPublicSaltLength} characters.";
            return false;
        }

        if (_length < MinLength)
        {
            _error = $"Length must be at least {MinLength}.";
            return false;
        }

        await GenerateAsync();
        return true;
    }


}
