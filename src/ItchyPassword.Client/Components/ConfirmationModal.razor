@namespace ItchyPassword.Client.Components

@if (IsVisible)
{
    <div class="modal-backdrop" @onclick="OnCancelClick">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@Title</h3>
            </div>
            <div class="modal-body">
                <p>@Message</p>
                @if (AdditionalContent is not null)
                {
                    @AdditionalContent
                }
            </div>
            <div class="modal-actions">
                @if (Actions is not null)
                {
                    @foreach (ModalAction action in Actions)
                    {
                        <button class="@action.CssClass modal-action-btn" disabled="@IsWorking" @onclick="() => HandleClick(action)">
                            <div class="modal-action-content">
                                <span class="modal-action-label">@action.Label</span>
                                @if (action.Description is not null)
                                {
                                    <span class="modal-action-desc">@action.Description</span>
                                }
                            </div>
                            @if (IsWorking && action == _workingAction)
                            {
                                <div class="loading-spinner-sm"></div>
                            }
                        </button>
                    }
                }
                <button class="button secondary modal-action-btn" disabled="@IsWorking" @onclick="OnCancelClick">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsWorking => _workingAction is not null;
    private ModalAction? _workingAction;
    /// <summary>
    /// Whether the modal is currently visible.
    /// </summary>
    [Parameter]
    public bool IsVisible { get; set; }

    /// <summary>
    /// The modal title.
    /// </summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// The main message displayed in the modal body.
    /// </summary>
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>
    /// Optional additional content rendered below the message (e.g. informational labels).
    /// </summary>
    [Parameter]
    public RenderFragment? AdditionalContent { get; set; }

    /// <summary>
    /// The action buttons to display (excluding Cancel, which is always shown).
    /// </summary>
    [Parameter]
    public IReadOnlyList<ModalAction>? Actions { get; set; }

    /// <summary>
    /// Callback invoked when the user clicks Cancel or the backdrop.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task HandleClick(ModalAction action)
    {
        if (IsWorking)
        {
            return;
        }

        _workingAction = action;
        StateHasChanged();

        try
        {
            await action.OnClick();
        }
        finally
        {
            _workingAction = null;
            StateHasChanged();
        }
    }

    private async Task OnCancelClick()
    {
        if (IsWorking)
        {
            return;
        }

        await OnCancel.InvokeAsync();
    }
}
