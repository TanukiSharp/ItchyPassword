@using ItchyPassword.Client.Services
@inject ClientVaultState State
@inject ICryptoService Crypto
@inject NavigationManager Nav
@inject LocalStorageService Storage

<div class="card vault-card">
    <div class="card-header vault-header">
        <h3 class="heading-flush">Vault Items</h3>
        <div class="vault-header-actions">
            <span class="vault-item-count">@FilteredItems.Count() items</span>
            <select class="input vault-filter-select" value="@_displayFilter" @onchange="OnFilterChanged">
                <option value="all">Show all</option>
                <option value="statickey">Static keys only</option>
                <option value="secret">Secrets only</option>
            </select>
            <button class="button secondary" @onclick="LockVault">Lock Workspace</button>
            <button class="button primary" @onclick="CreateNew">New Item</button>
        </div>
    </div>

    <div class="vault-search">
        <input class="input" type="text" placeholder="Search items..." @bind="State.SearchQuery" @bind:event="oninput" />
    </div>

    <div class="vault-scroll-area">
        <table class="table vault-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (VaultItemV2 item in FilteredItems)
                {
                    <tr>
                        <td>
                            <span class="vault-item-name">
                                @if (item.Type == VaultItemTypeV2.StaticKey)
                                {
                                    <img class="vault-icon-key" src="icons/key-dark.svg" alt="Static key" width="14" height="14" />
                                }
                                @item.Name
                            </span>
                        </td>
                        <td class="text-right">
                            <div class="vault-actions-group">
                                <CopyButton CssClass="vault-item-action-btn" TextProvider="() => GetItemValueAsync(item)" />
                                <button class="button secondary vault-item-action-btn" @onclick="() => EditItem(item)" title="Edit item">
                                    <img src="icons/edit-dark.svg" width="14" height="14" alt="Edit" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (FilteredItems.Any() == false)
                {
                    <tr>
                        <td colspan="2" class="vault-empty-row">
                            No items found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private const string DisplayFilterStorageKey = "itchypassword_vault_display_filter";

    private string _displayFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        string? stored = await Storage.GetItemAsync(DisplayFilterStorageKey);

        if (string.IsNullOrWhiteSpace(stored) == false)
        {
            _displayFilter = stored;
        }
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        _displayFilter = e.Value?.ToString() ?? "all";
        await Storage.SetItemAsync(DisplayFilterStorageKey, _displayFilter);
    }

    private void CreateNew()
    {
        Nav.NavigateTo("item/new");
    }

    private void LockVault()
    {
        State.MasterKey = "";
        Nav.NavigateTo("/");
    }

    private IEnumerable<VaultItemV2> FilteredItems
    {
        get
        {
            if (State.Vault is null)
            {
                return Enumerable.Empty<VaultItemV2>();
            }

            IEnumerable<VaultItemV2> items = State.Vault.Items;

            // Apply type filter.
            if (_displayFilter == "statickey")
            {
                items = items.Where(i => i.Type == VaultItemTypeV2.StaticKey);
            }
            else if (_displayFilter == "secret")
            {
                items = items.Where(i => i.Type == VaultItemTypeV2.Secret);
            }

            // Apply search filter.
            if (string.IsNullOrWhiteSpace(State.SearchQuery) == false)
            {
                string query = State.SearchQuery;
                items = items.Where(i =>
                    i.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    i.Metadata?.Any(m =>
                        m.Key.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                        m.Value.Contains(query, StringComparison.OrdinalIgnoreCase)
                    ) == true
                );
            }

            return items;
        }
    }

    private void EditItem(VaultItemV2 item)
    {
        Nav.NavigateTo($"edit/{item.Id:N}");
    }

    /// <summary>
    /// Decrypts a secret or generates a static key password and returns the plaintext value.
    /// </summary>
    private Task<string> GetItemValueAsync(VaultItemV2 item)
    {
        return item.Type switch
        {
            VaultItemTypeV2.Secret => DecryptSecretAsync(item),
            VaultItemTypeV2.StaticKey => GenerateStaticKeyAsync(item),
            _ => throw new NotSupportedException($"Unsupported item type: {item.Type}")
        };
    }

    private async Task<string> DecryptSecretAsync(VaultItemV2 item)
    {
        if (item.SecretData is null || string.IsNullOrWhiteSpace(item.SecretData.Cipher))
        {
            throw new InvalidOperationException("No secret data to decrypt.");
        }

        SecretDataV2 data = item.SecretData;
        byte[] encryptedBytes = DecodeString(data.Cipher, data.Encoding);
        byte[] passwordBytes = System.Text.Encoding.UTF8.GetBytes(State.MasterKey);

        byte[] decryptedBytes = data.CryptoVersion switch
        {
            3 => await Crypto.DecryptV3Async(encryptedBytes, passwordBytes),
            _ => throw new NotSupportedException($"Cipher version {data.CryptoVersion} is not supported.")
        };

        return System.Text.Encoding.UTF8.GetString(decryptedBytes);
    }

    private async Task<string> GenerateStaticKeyAsync(VaultItemV2 item)
    {
        if (item.StaticKeyData is null)
        {
            throw new InvalidOperationException("No static key data.");
        }

        StaticKeyDataV2 keyData = item.StaticKeyData;
        byte[] privatePart = System.Text.Encoding.UTF8.GetBytes(State.MasterKey);
        byte[] publicPart = System.Text.Encoding.UTF8.GetBytes(keyData.PublicPart);

        byte[] rawBytes = keyData.CryptoVersion switch
        {
            1 => await Crypto.GeneratePasswordV1Async(privatePart, publicPart),
            2 => await Crypto.GeneratePasswordV2Async(privatePart, publicPart),
            _ => throw new NotSupportedException($"Crypto version {keyData.CryptoVersion} is not supported.")
        };

        string result = keyData.EncodingVersion switch
        {
            1 => BaseN.EncodeOneWay(rawBytes, keyData.Alphabet),
            2 => BaseN.Encode(rawBytes, keyData.Alphabet),
            _ => throw new NotSupportedException($"Encoding version {keyData.EncodingVersion} is not supported.")
        };

        if (result.Length > keyData.Length)
        {
            result = result[..keyData.Length];
        }

        return result;
    }

    private static byte[] DecodeString(string data, string encoding)
    {
        return encoding switch
        {
            "base58" => Base58.Decode(data),
            "base62" => BaseN.Decode(data, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"),
            "base64" => Convert.FromBase64String(data),
            _ => Base58.Decode(data)
        };
    }
}
