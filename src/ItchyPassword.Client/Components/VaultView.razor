@using ItchyPassword.Core.Models
@using ItchyPassword.Core.Services
@using ItchyPassword.Core.Extensions
@inject VaultSession Session
@inject IMasterKeyProvider MasterKeyProvider
@inject IAppState AppState
@inject IVaultCryptoService VaultCrypto
@inject NavigationManager Nav
@inject ILocalStorageService Storage

<div class="card vault-card">
    <div class="card-header vault-header">
        <div class="vault-header-actions">
            <span class="vault-item-count">@FilteredItems.Count items</span>
            <select class="input vault-filter-select" value="@_displayFilter" @onchange="OnFilterChanged">
                <option value="all">Show all</option>
                <option value="statickey">Static keys</option>
                <option value="secret">Secrets</option>
            </select>
            <button class="button icon-button secondary" @onclick="ReloadVaultAsync" title="Reload vault from storage." disabled="@_isReloading">
                <img class="themed-icon" src="icons/reload-dark.svg" width="16" height="16" alt="Reload the vault." />
            </button>
            <button class="button icon-button primary" @onclick="CreateNew" title="Create a new vault item.">
                <img class="themed-icon" src="icons/plus-dark.svg" width="16" height="16" alt="New item" />
            </button>
        </div>
    </div>

    <div class="vault-search">
        <div class="vault-search-row">
            <input class="input vault-search-input" type="text" placeholder="Search items..." @bind="AppState.SearchQuery" @bind:event="oninput" />
            <select class="input vault-search-mode" value="@_searchMode" @onchange="OnSearchModeChanged" title="Search mode">
                <option value="@SearchMode.Contains">Contains</option>
                <option value="@SearchMode.Fuzzy">Fuzzy</option>
                <option value="@SearchMode.Exact">Exact</option>
            </select>
        </div>
    </div>

    <div class="vault-scroll-area">
        <table class="table vault-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (VaultItemMatch match in FilteredItems)
                {
                    <tr>
                        <td>
                            <span class="vault-item-name">
                                @if (match.Item.IsLegacy())
                                {
                                    <span class="legacy-indicator" title="This item uses legacy settings. Edit and save to upgrade.">⚠️</span>
                                }
                                @if (match.Item.Type == VaultItemTypeV2.StaticKey)
                                {
                                    <img class="vault-icon-key" src="icons/key-dark.svg" alt="Static key" width="14" height="14" />
                                }
                                @RenderSegmentedName(match)
                            </span>

                            @if (match.HasMetadataMatch)
                            {
                                <div class="vault-metadata-matches">
                                    @foreach (MetadataMatch metaMatch in match.MetadataMatches)
                                    {
                                        <span class="vault-metadata-tag">
                                            <span>@RenderHighlightedText(metaMatch.Key, metaMatch.KeyResult.Ranges)</span>
                                            @if (string.IsNullOrEmpty(metaMatch.Value) == false)
                                            {
                                                <span>: @RenderHighlightedText(metaMatch.Value, metaMatch.ValueResult.Ranges)</span>
                                            }
                                        </span>
                                    }
                                </div>
                            }
                        </td>
                        <td class="text-right">
                            <div class="vault-actions-group">
                                <CopyButton CssClass="vault-item-action-btn" TextProvider="() => GetItemValueAsync(match.Item, CancellationToken.None)" />
                                <button class="button secondary vault-item-action-btn" @onclick="() => EditItem(match.Item)" title="Edit item">
                                    <img class="themed-icon" src="icons/edit-dark.svg" width="14" height="14" alt="Edit" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (FilteredItems.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="vault-empty-row">
                            No items found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private const string DisplayFilterStorageKey = "vault_display_filter";
    private const string SearchModeStorageKey = "vault_search_mode";

    private string _displayFilter = "all";
    private SearchMode _searchMode = SearchMode.Contains;

    protected override async Task OnInitializedAsync()
    {
        string? stored = await Storage.GetItemAsync(DisplayFilterStorageKey, CancellationToken.None);

        if (string.IsNullOrWhiteSpace(stored) == false)
        {
            _displayFilter = stored;
        }

        string? storedMode = await Storage.GetItemAsync(SearchModeStorageKey, CancellationToken.None);

        if (Enum.TryParse<SearchMode>(storedMode, out SearchMode parsedMode))
        {
            _searchMode = parsedMode;
        }
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        _displayFilter = e.Value?.ToString() ?? "all";
        await Storage.SetItemAsync(DisplayFilterStorageKey, _displayFilter, CancellationToken.None);
    }

    private async Task OnSearchModeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<SearchMode>(e.Value?.ToString(), out SearchMode mode))
        {
            _searchMode = mode;
        }

        await Storage.SetItemAsync(SearchModeStorageKey, _searchMode.ToString(), CancellationToken.None);
    }

    private void CreateNew()
    {
        Nav.NavigateTo("item/new");
    }

    private bool _isReloading = false;

    private async Task ReloadVaultAsync()
    {
        _isReloading = true;

        try
        {
            await AppState.ReloadVaultAsync(CancellationToken.None);
        }
        finally
        {
            _isReloading = false;
        }
    }

    private async Task UnloadVaultAsync()
    {
        await AppState.UnloadAsync();
    }

    /// <summary>
    /// Renders the item name split into actionable segments (links / copy) and plain text.
    /// Consecutive non-actionable tokens (short words, spaces, punctuation) are coalesced
    /// into single text runs to minimize DOM nodes.
    /// </summary>
    private RenderFragment RenderSegmentedName(VaultItemMatch match)
    {
        string name = match.Item.Name;
        IReadOnlyList<MatchRange> nameRanges = match.NameResult.Ranges;

        _nameSegmentBuffer.Clear();
        _searchRangeBuffer.Clear();
        BuildNameSegments(name, nameRanges);

        // Capture snapshot for the lambda closure (lists are reused, so we need copies).
        NameSegment[] nameSegments = [.. _nameSegmentBuffer];
        MatchRange[] searchRanges = [.. _searchRangeBuffer];

        return builder =>
        {
            int seq = 0;

            foreach (NameSegment seg in nameSegments)
            {
                if (seg.IsActionable)
                {
                    builder.OpenComponent<ActionSegment>(seq++);
                    builder.AddAttribute(seq++, nameof(ActionSegment.Text), name.Substring(seg.Start, seg.Length));
                    builder.AddAttribute(seq++, nameof(ActionSegment.ChildContent),
                        RenderHighlightedSegment(name, seg.Start, seg.Length, searchRanges, seg.SearchRangeStart, seg.SearchRangeCount));
                    builder.CloseComponent();
                }
                else
                {
                    builder.AddContent(seq++,
                        RenderHighlightedSegment(name, seg.Start, seg.Length, searchRanges, seg.SearchRangeStart, seg.SearchRangeCount));
                }
            }
        };
    }

    /// <summary>
    /// Offset-based highlighted text rendering for name segments.
    /// Extracts a substring slice and renders highlight marks from the shared range buffer.
    /// </summary>
    private static RenderFragment RenderHighlightedSegment(
        string fullText, int start, int length,
        MatchRange[] searchRanges, int searchRangeStart, int searchRangeCount)
    {
        return builder =>
        {
            if (searchRangeCount == 0)
            {
                builder.AddContent(0, fullText.AsMemory(start, length));
                return;
            }

            int seq = 0;
            builder.OpenElement(seq++, "span");

            int lastIndex = 0;

            for (int i = searchRangeStart; i < searchRangeStart + searchRangeCount; i++)
            {
                MatchRange range = searchRanges[i];

                if (range.Position > lastIndex)
                {
                    builder.AddContent(seq++, fullText.AsMemory(start + lastIndex, range.Position - lastIndex));
                }

                builder.OpenElement(seq++, "mark");
                builder.AddAttribute(seq++, "class", "search-highlight");
                builder.AddContent(seq++, fullText.AsMemory(start + range.Position, range.Length));
                builder.CloseElement();

                lastIndex = range.Position + range.Length;
            }

            if (lastIndex < length)
            {
                builder.AddContent(seq++, fullText.AsMemory(start + lastIndex, length - lastIndex));
            }

            builder.CloseElement();
        };
    }

    /// <summary>
    /// Renders text with the given match ranges highlighted.
    /// </summary>
    private RenderFragment RenderHighlightedText(string text, IReadOnlyList<MatchRange> ranges)
    {
        return builder =>
        {
            if (ranges.Count == 0)
            {
                builder.AddContent(0, text);
                return;
            }

            int sequence = 0;

            // Wrap in a span so multiple nodes (text + mark + text) stay as one flex child.
            builder.OpenElement(sequence++, "span");

            int lastIndex = 0;

            foreach (MatchRange range in ranges)
            {
                if (range.Position > lastIndex)
                {
                    builder.AddContent(sequence++, text[lastIndex..range.Position]);
                }

                builder.OpenElement(sequence++, "mark");
                builder.AddAttribute(sequence++, "class", "search-highlight");
                builder.AddContent(sequence++, text.Substring(range.Position, range.Length));
                builder.CloseElement();

                lastIndex = range.Position + range.Length;
            }

            if (lastIndex < text.Length)
            {
                builder.AddContent(sequence++, text[lastIndex..]);
            }

            builder.CloseElement();
        };
    }

    private List<VaultItemMatch> FilteredItems
    {
        get
        {
            if (Session.Vault is null)
            {
                return [];
            }

            IEnumerable<VaultItemV2> items = Session.Vault.Value.Items;

            // Apply type filter.
            if (_displayFilter == "statickey")
            {
                items = items.Where(i => i.Type == VaultItemTypeV2.StaticKey);
            }
            else if (_displayFilter == "secret")
            {
                items = items.Where(i => i.Type == VaultItemTypeV2.Secret);
            }

            // No search query: return all items without match data.
            if (string.IsNullOrWhiteSpace(AppState.SearchQuery))
            {
                return items.Select(i => new VaultItemMatch(i)).ToList();
            }

            string query = AppState.SearchQuery;
            var results = new List<VaultItemMatch>();

            foreach (VaultItemV2 item in items)
            {
                SearchResult nameResult = SearchHelper.Match(item.Name, query, _searchMode);
                var metadataMatches = new List<MetadataMatch>();

                if (item.Metadata is not null)
                {
                    foreach (MetadataEntryV2 meta in item.Metadata)
                    {
                        SearchResult keyResult = SearchHelper.Match(meta.Key, query, _searchMode);
                        SearchResult valueResult = SearchHelper.Match(meta.Value, query, _searchMode);

                        if (keyResult.IsMatch || valueResult.IsMatch)
                        {
                            metadataMatches.Add(new MetadataMatch(meta.Key, meta.Value, keyResult, valueResult));
                        }
                    }
                }

                if (nameResult.IsMatch || metadataMatches.Count > 0)
                {
                    results.Add(new VaultItemMatch(item, nameResult, metadataMatches));
                }
            }

            return results;
        }
    }

    private void EditItem(VaultItemV2 item)
    {
        Nav.NavigateTo($"edit/{item.Id:N}");
    }

    /// <summary>
    /// Decrypts a secret or generates a static key password and returns the plaintext value.
    /// </summary>
    private Task<string> GetItemValueAsync(VaultItemV2 item, CancellationToken cancellationToken)
    {
        return item.Type switch
        {
            VaultItemTypeV2.Secret => DecryptSecretAsync(item, cancellationToken),
            VaultItemTypeV2.StaticKey => GenerateStaticKeyAsync(item, cancellationToken),
            _ => throw new NotSupportedException($"Unsupported item type: {item.Type}")
        };
    }

    private async Task<string> DecryptSecretAsync(VaultItemV2 item, CancellationToken cancellationToken)
    {
        if (item.SecretData is null)
        {
            throw new InvalidOperationException("Invalid secret data.");
        }

        return await VaultCrypto.DecryptSecretAsync(item.SecretData!.Value, MasterKeyProvider.MasterKey, cancellationToken);
    }

    private async Task<string> GenerateStaticKeyAsync(VaultItemV2 item, CancellationToken cancellationToken)
    {
        if (item.StaticKeyData is null)
        {
            throw new InvalidOperationException("Invalid static key data.");
        }

        return await VaultCrypto.GenerateStaticKeyAsync(item.StaticKeyData!.Value, MasterKeyProvider.MasterKey, cancellationToken);
    }

    // ── Name segmentation ───────────────────────────────────────────

    /// <summary>
    /// Represents a slice of the item name string, referencing highlight ranges
    /// in the shared <see cref="_searchRangeBuffer"/>.
    /// </summary>
    private readonly struct NameSegment
    {
        public readonly int Start;
        public readonly int Length;
        public readonly int SearchRangeStart;
        public readonly int SearchRangeCount;
        public readonly bool IsActionable;

        public NameSegment(int start, int length, int searchRangeStart, int searchRangeCount, bool isActionable)
        {
            Start = start;
            Length = length;
            SearchRangeStart = searchRangeStart;
            SearchRangeCount = searchRangeCount;
            IsActionable = isActionable;
        }
    }

    /// <summary>
    /// Reusable buffer for name segments. Cleared and reused per item to avoid allocations.
    /// </summary>
    private readonly List<NameSegment> _nameSegmentBuffer = [];

    /// <summary>
    /// Reusable buffer for per-segment highlight ranges. Each <see cref="NameSegment"/>
    /// references a slice of this list via SearchRangeStart/SearchRangeCount.
    /// </summary>
    private readonly List<MatchRange> _searchRangeBuffer = [];

    /// <summary>
    /// Splits the item name into segments by spaces using zero-copy span enumeration.
    /// Consecutive non-actionable tokens (words with 3 or fewer characters, spaces)
    /// are coalesced into a single segment to minimize DOM nodes.
    /// Results are written into <see cref="_nameSegmentBuffer"/> and <see cref="_searchRangeBuffer"/>.
    /// </summary>
    private void BuildNameSegments(string name, IReadOnlyList<MatchRange> nameRanges)
    {
        ReadOnlySpan<char> span = name.AsSpan();
        int accumStart = -1;
        int accumEnd = 0;
        int prevEnd = 0;

        foreach (Range wordRange in span.Split(' '))
        {
            int wordStart = wordRange.Start.Value;
            int wordEnd = wordRange.End.Value;
            int wordLength = wordEnd - wordStart;

            // Account for space gap between previous token end and this token start.
            // The gap is always non-actionable and extends the accumulator.
            bool isActionable = wordLength > 3;

            if (isActionable)
            {
                // Flush any accumulated non-actionable run including the space gap before this word.
                int spaceGapEnd = wordStart;

                if (accumStart >= 0)
                {
                    // Extend accumulator to cover the space gap.
                    int flushStart = accumStart;
                    int flushLength = spaceGapEnd - flushStart;
                    FlushSegment(flushStart, flushLength, nameRanges, isActionable: false);
                    accumStart = -1;
                }
                else if (spaceGapEnd > prevEnd)
                {
                    // Spaces before this word with no prior accumulation.
                    FlushSegment(prevEnd, spaceGapEnd - prevEnd, nameRanges, isActionable: false);
                }

                // Emit the actionable word.
                FlushSegment(wordStart, wordLength, nameRanges, isActionable: true);
            }
            else
            {
                // Non-actionable word: start or extend the accumulator.
                if (accumStart < 0)
                {
                    // Include any space gap before this word.
                    accumStart = prevEnd;
                }

                accumEnd = wordEnd;
            }

            prevEnd = wordEnd;
        }

        // Flush remaining accumulated non-actionable text.
        if (accumStart >= 0)
        {
            FlushSegment(accumStart, accumEnd - accumStart, nameRanges, isActionable: false);
        }
    }

    /// <summary>
    /// Emits a <see cref="NameSegment"/> into the buffer, slicing highlight ranges
    /// from the full-name ranges into the shared range buffer.
    /// </summary>
    private void FlushSegment(int start, int length, IReadOnlyList<MatchRange> nameRanges, bool isActionable)
    {
        if (length <= 0)
        {
            return;
        }

        int searchRangeStart = _searchRangeBuffer.Count;
        SliceSearchRangesInto(nameRanges, start, length);
        int searchRangeCount = _searchRangeBuffer.Count - searchRangeStart;

        _nameSegmentBuffer.Add(new NameSegment(start, length, searchRangeStart, searchRangeCount, isActionable));
    }

    /// <summary>
    /// Clips full-name highlight ranges to a segment boundary and appends
    /// the resulting offset-adjusted ranges into <see cref="_searchRangeBuffer"/>.
    /// </summary>
    private void SliceSearchRangesInto(IReadOnlyList<MatchRange> fullRanges, int startOffset, int length)
    {
        int segEnd = startOffset + length;

        foreach (MatchRange range in fullRanges)
        {
            int rangeEnd = range.Position + range.Length;

            // Skip ranges entirely outside this segment.
            if (rangeEnd <= startOffset || range.Position >= segEnd)
            {
                continue;
            }

            // Clip to segment boundaries.
            int clippedStart = Math.Max(range.Position, startOffset);
            int clippedEnd = Math.Min(rangeEnd, segEnd);

            _searchRangeBuffer.Add(new MatchRange(clippedStart - startOffset, clippedEnd - clippedStart));
        }
    }
}
