@using ItchyPassword.Client.Services
@using ItchyPassword.Core.Services
@inject VaultSession Session
@inject IMasterKeyProvider MasterKeyProvider
@inject IAppState AppState
@inject IVaultCryptoService VaultCrypto
@inject NavigationManager Nav
@inject ILocalStorageService Storage

<div class="card vault-card">
    <div class="card-header vault-header">
        <h3 class="heading-flush">Vault Items</h3>
        <div class="vault-header-actions">
            <span class="vault-item-count">@FilteredItems.Count items</span>
            <select class="input vault-filter-select" value="@_displayFilter" @onchange="OnFilterChanged">
                <option value="all">Show all</option>
                <option value="statickey">Static keys only</option>
                <option value="secret">Secrets only</option>
            </select>
            <button class="button secondary" @onclick="LockVault" title="Clears the master key and unloads all vault data.">Lock vault</button>
            <button class="button primary" @onclick="CreateNew" title="Create a new vault item.">New Item</button>
        </div>
    </div>

    <div class="vault-search">
        <input class="input" type="text" placeholder="Search items..." @bind="AppState.SearchQuery" @bind:event="oninput" />
    </div>

    <div class="vault-scroll-area">
        <table class="table vault-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (VaultItemV2 item in FilteredItems)
                {
                    <tr>
                        <td>
                            <span class="vault-item-name">
                                @if (item.Type == VaultItemTypeV2.StaticKey)
                                {
                                    <img class="vault-icon-key" src="icons/key-dark.svg" alt="Static key" width="14" height="14" />
                                }
                                @item.Name
                            </span>
                        </td>
                        <td class="text-right">
                            <div class="vault-actions-group">
                                <CopyButton CssClass="vault-item-action-btn" TextProvider="() => GetItemValueAsync(item)" />
                                <button class="button secondary vault-item-action-btn" @onclick="() => EditItem(item)" title="Edit item">
                                    <img src="icons/edit-dark.svg" width="14" height="14" alt="Edit" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (FilteredItems.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="vault-empty-row">
                            No items found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private const string DisplayFilterStorageKey = "itchypassword_vault_display_filter";

    private string _displayFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        string? stored = await Storage.GetItemAsync(DisplayFilterStorageKey);

        if (string.IsNullOrWhiteSpace(stored) == false)
        {
            _displayFilter = stored;
        }
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        _displayFilter = e.Value?.ToString() ?? "all";
        await Storage.SetItemAsync(DisplayFilterStorageKey, _displayFilter);
    }

    private void CreateNew()
    {
        Nav.NavigateTo("item/new");
    }

    private void LockVault()
    {
        AppState.Lock();
    }

    private List<VaultItemV2> FilteredItems
    {
        get
        {
            if (Session.Vault is null)
            {
                return [];
            }

            IEnumerable<VaultItemV2> items = Session.Vault.Items;

            // Apply type filter.
            if (_displayFilter == "statickey")
            {
                items = items.Where(i => i.Type == VaultItemTypeV2.StaticKey);
            }
            else if (_displayFilter == "secret")
            {
                items = items.Where(i => i.Type == VaultItemTypeV2.Secret);
            }

            // Apply search filter.
            if (string.IsNullOrWhiteSpace(AppState.SearchQuery) == false)
            {
                string query = AppState.SearchQuery;
                items = items.Where(i =>
                    i.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    i.Metadata?.Any(m =>
                        m.Key.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                        m.Value.Contains(query, StringComparison.OrdinalIgnoreCase)
                    ) == true
                );
            }

            return items.ToList();
        }
    }

    private void EditItem(VaultItemV2 item)
    {
        Nav.NavigateTo($"edit/{item.Id:N}");
    }

    /// <summary>
    /// Decrypts a secret or generates a static key password and returns the plaintext value.
    /// </summary>
    private Task<string> GetItemValueAsync(VaultItemV2 item)
    {
        return item.Type switch
        {
            VaultItemTypeV2.Secret => DecryptSecretAsync(item),
            VaultItemTypeV2.StaticKey => GenerateStaticKeyAsync(item),
            _ => throw new NotSupportedException($"Unsupported item type: {item.Type}")
        };
    }

    private async Task<string> DecryptSecretAsync(VaultItemV2 item)
    {
        if (item.SecretData is null)
        {
            throw new InvalidOperationException("Invalid secret data.");
        }

        return await VaultCrypto.DecryptSecretAsync(item.SecretData, MasterKeyProvider.MasterKey);
    }

    private async Task<string> GenerateStaticKeyAsync(VaultItemV2 item)
    {
        if (item.StaticKeyData is null)
        {
            throw new InvalidOperationException("Invalid static key data.");
        }

        return await VaultCrypto.GenerateStaticKeyAsync(item.StaticKeyData, MasterKeyProvider.MasterKey);
    }
}
