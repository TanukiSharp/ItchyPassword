@using ItchyPassword.Client.Services
@inject ClientVaultState State
@inject ICryptoService Crypto
@inject NavigationManager Nav

<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0;">Vault Items</h3>
        <div style="display: flex; gap: 0.5rem;">
            <button class="button secondary" @onclick="LockVault">Lock Workspace</button>
            <button class="button primary" @onclick="CreateNew">New Item</button>
        </div>
    </div>

    <div style="margin-bottom: 1rem;">
        <input class="input" type="text" placeholder="Search items..." @bind="State.SearchQuery" @bind:event="oninput" />
    </div>

    <div style="overflow-x: auto;">
        <table class="table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="padding: 0.75rem; text-align: left; border-bottom: 2px solid var(--border-color);">Name</th>
                    <th style="padding: 0.75rem; text-align: left; border-bottom: 2px solid var(--border-color);">Modified</th>
                    <th style="padding: 0.75rem; text-align: right; border-bottom: 2px solid var(--border-color);">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (VaultItemV2 item in FilteredItems)
                {
                    <tr style="border-bottom: 1px solid var(--border-color);">
                        <td style="padding: 0.75rem;">@item.Name</td>
                        <td style="padding: 0.75rem;">@item.LastModified.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td style="padding: 0.75rem; text-align: right;">
                            <button class="button secondary" @onclick="() => EditItem(item)">Edit</button>
                        </td>
                    </tr>
                }
                @if (FilteredItems.Any() == false)
                {
                    <tr>
                        <td colspan="4" style="padding: 2rem; text-align: center; color: var(--text-muted);">
                            No items found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private void CreateNew()
    {
        Nav.NavigateTo("item/new");
    }

    private void LockVault()
    {
        State.MasterKey = "";
        Nav.NavigateTo("/");
    }

    private IEnumerable<VaultItemV2> FilteredItems
    {
        get
        {
            if (State.Vault is null)
            {
                return Enumerable.Empty<VaultItemV2>();
            }
            if (string.IsNullOrWhiteSpace(State.SearchQuery))
            {
                return State.Vault.Items;
            }

            // Basic search (Fuzzy later)
            return State.Vault.Items.Where(i =>
                i.Name.Contains(State.SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Metadata?.Any(m =>
                    m.Key.Contains(State.SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    m.Value.Contains(State.SearchQuery, StringComparison.OrdinalIgnoreCase)
                ) == true
            );
        }
    }

    private void EditItem(VaultItemV2 item)
    {
        // Navigate or Open Modal
        Nav.NavigateTo($"edit/{item.Id:N}");
    }
}
