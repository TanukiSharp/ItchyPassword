<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <PropertyGroup>
    <FingerprintStaticAssets>false</FingerprintStaticAssets>
    <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItchyPassword.Core\ItchyPassword.Core.csproj" />
  </ItemGroup>

  <Import Project="GitVersion.targets" />

  <!-- Clean bin and obj before publish to avoid stale files. -->
  <Target Name="CleanBeforePublish" BeforeTargets="Publish">
    <RemoveDir Directories="$(BaseIntermediateOutputPath)" />
    <RemoveDir Directories="$(BaseOutputPath)" />
    <Message Importance="high" Text="Cleaned bin and obj directories." />
  </Target>

  <!-- Copy published assets to docs/vnext for GitHub Pages deployment. -->
  <Target Name="CopyToDocsVNext" AfterTargets="Publish">
    <PropertyGroup>
      <DocsVNextDir>$(MSBuildThisFileDirectory)..\..\docs\vnext\</DocsVNextDir>
      <PublishWwwrootDir>$(PublishDir)wwwroot\</PublishWwwrootDir>
    </PropertyGroup>

    <RemoveDir Directories="$(DocsVNextDir)" />

    <ItemGroup>
      <PublishFiles Include="$(PublishWwwrootDir)**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(PublishFiles)" DestinationFiles="@(PublishFiles->'$(DocsVNextDir)%(RecursiveDir)%(Filename)%(Extension)')" />

    <Message Importance="high" Text="Published assets copied to docs/vnext." />
  </Target>

</Project>
