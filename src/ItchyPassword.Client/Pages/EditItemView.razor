@page "/edit/{ItemId}"
@using ItchyPassword.Client.Services
@using ItchyPassword.Client.Services.VaultConnectors
@using ItchyPassword.Client.Components.Editors
@inject ClientVaultState State
@inject ICryptoService Crypto
@inject NavigationManager Nav

@if (_item is null)
{
    <p>Item not found.</p>
}
else
{
    <div class="card" style="max-width: 800px; margin: 0 auto;">
        <div class="card-header">
            <h3 style="margin: 0;">Edit @_item.Name</h3>
        </div>

        <div style="padding: 1rem;">
            <EditForm Model="_item" OnValidSubmit="SaveAsync">
                <div class="form-group">
                    <label>Name</label>
                    <input class="input" @bind="_item.Name" required />
                </div>

                <div class="form-group">
                    <label>Type: <strong>@_item.Type</strong></label>
                </div>

                <hr style="margin: 1.5rem 0; border: 0; border-top: 1px solid var(--border-color);" />

                @if (_item.Type == VaultItemType.StaticKey)
                {
                    <StaticKeyEditor Item="@_item" />
                }
                else
                {
                    <SecretEditor @ref="_secretEditor" Item="@_item" />
                }

                <div style="margin-top: 2rem; display: flex; gap: 1rem;">
                    <button class="button primary" type="submit" disabled="@_isSaving">
                        @if (_isSaving) { <span>Saving...</span> } else { <span>Save to vault</span> }
                    </button>
                    <button class="button secondary" type="button" @onclick="Cancel">Cancel</button>
                </div>
            </EditForm>

            @if (string.IsNullOrWhiteSpace(_error) == false)
            {
                <div class="alert danger" style="margin-top: 1rem;">@_error</div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public required string ItemId { get; set; }

    private VaultItem? _item;
    private bool _isSaving = false;
    private string _error = string.Empty;

    // Component reference for calling encrypt at save time.
    private SecretEditor? _secretEditor;

    protected override void OnInitialized()
    {
        if (State.Vault is null || Guid.TryParse(ItemId, out Guid parsedId) == false)
        {
            Nav.NavigateTo("/");
            return;
        }

        _item = State.Vault.Items.FirstOrDefault(i => i.Id == parsedId);
    }

    private async Task SaveAsync()
    {
        if (State.Vault is null || _item is null)
        {
            return;
        }

        _isSaving = true;
        _error = string.Empty;

        try
        {
            // For Secret items, encrypt the plaintext before saving.
            if (_item.Type == VaultItemType.Secret && _secretEditor is not null)
            {
                bool encrypted = await _secretEditor.EncryptAndStoreAsync();

                if (encrypted == false)
                {
                    _isSaving = false;
                    return;
                }
            }

            // Update Timestamp
            _item.LastModified = DateTime.UtcNow;

            // 1. Serialize entire vault
            string json = VaultDataService.SerializeVault(State.Vault);

            // 2. Parallel save to all Write Connectors
            var tasks = State.WriteConnectors.Select(async c =>
            {
                try
                {
                    // Use connector's internal version tracking
                    await c.SaveVaultAsync(json);
                    return (Connector: c, Success: true, Error: "");
                }
                catch (Exception ex)
                {
                    return (Connector: c, Success: false, Error: ex.Message);
                }
            });

            var results = await Task.WhenAll(tasks);

            var failures = results.Where(r => r.Success == false).ToList();

            if (failures.Count > 0)
            {
                _error = "Partial save failure: " + string.Join(", ", failures.Select(f => $"{f.Connector.Name}: {f.Error}"));
                // If ALL failed, don't navigate
                if (results.All(r => r.Success == false))
                {
                    return;
                }
            }

            Nav.NavigateTo("/vault");
        }
        catch (Exception ex)
        {
            _error = $"Save failed: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/vault");
    }
}
