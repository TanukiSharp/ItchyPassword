@page "/edit/{ItemId}"
@using ItchyPassword.Client.Services
@using ItchyPassword.Client.Components.Editors
@using ItchyPassword.Core.Services
@inject VaultSession Session
@inject NavigationManager Nav
@inject IAppState AppState
@inject IJSRuntime JS

@if (_item is null)
{
    <p>Item not found.</p>
}
else
{
    <div class="card page-container">
        <div class="card-header">
            <h3 class="heading-flush">Edit @_item.Name</h3>
            <span class="text-muted timestamp">Created: @_item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
            <span class="text-muted timestamp">Last modified: @_item.LastModified.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
        </div>

        <div class="card-body">
            <EditForm Model="_item" OnValidSubmit="SaveAsync">
                <div class="form-group">
                    <label>Name</label>
                    <input class="input" @bind="_item.Name" required />
                </div>

                <div class="form-group">
                    <label>Type: <strong>@_item.Type</strong></label>
                </div>

                <hr class="section-divider" />

                @if (_item.Type == VaultItemTypeV2.StaticKey)
                {
                    <StaticKeyEditor @ref="_editor" Item="@_item" />
                }
                else
                {
                    <SecretEditor @ref="_editor" Item="@_item" />
                }

                <hr class="section-divider" />

                <MetadataEditor @ref="_metadataEditor" Item="@_item" />

                <div class="form-actions">
                    <button class="button primary" type="submit" disabled="@_isSaving">
                        @if (_isSaving) { <span>Saving...</span> } else { <span>Save to vault</span> }
                    </button>
                    <button class="button secondary" type="button" @onclick="Cancel">Cancel</button>
                    <button class="button danger" type="button" @onclick="DeleteAsync" disabled="@_isSaving" style="margin-left: auto;">Delete</button>
                </div>
            </EditForm>

            @if (string.IsNullOrWhiteSpace(_error) == false)
            {
                <div class="alert danger alert-inline">@_error</div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public required string ItemId { get; set; }

    private VaultItemV2? _item;
    private bool _isSaving = false;
    private string _error = string.Empty;

    // Component reference for calling PrepareForSaveAsync at save time.
    private IItemEditor? _editor;

    // Component reference for finalizing metadata before saving.
    private MetadataEditor? _metadataEditor;

    protected override void OnInitialized()
    {
        if (AppState.Status != AppStatus.Unlocked)
        {
            Nav.NavigateTo("/");
            return;
        }

        if (Guid.TryParse(ItemId, out Guid parsedId) == false)
        {
            return;
        }

        if (Session.Vault is not null)
        {
            _item = Session.Vault.Items.FirstOrDefault(i => i.Id == parsedId);
        }
    }

    private async Task SaveAsync()
    {
        if (Session.Vault is null || _item is null)
        {
            return;
        }

        _isSaving = true;
        _error = string.Empty;

        try
        {
            // Let the editor finalize item data (encrypt, generate, etc.).
            if (_editor is not null)
            {
                bool ready = await _editor.PrepareForSaveAsync();

                if (ready == false)
                {
                    _isSaving = false;
                    return;
                }
            }

            // Let the metadata editor finalize metadata (encrypt flagged values, etc.).
            if (_metadataEditor is not null)
            {
                bool metadataReady = await _metadataEditor.PrepareMetadataAsync();

                if (metadataReady == false)
                {
                    _isSaving = false;
                    return;
                }
            }

            // Update Timestamp
            _item.LastModified = DateTime.UtcNow;

            // Serialize entire vault and persist to all write connectors.
            var results = await Session.SaveVaultAsync();
            var failures = results.Where(r => r.Success == false).ToList();

            if (failures.Count > 0)
            {
                _error = "Partial save failure: " + string.Join(", ", failures.Select(f => $"{f.Connector.Name}: {f.Error}"));
                // If ANY failed, stay on page to show error
                return;
            }

            Nav.NavigateTo("/vault");
        }
        catch (Exception ex)
        {
            _error = $"Save failed: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_item is null)
        {
            return;
        }

        if (Session.Vault is null)
        {
            return;
        }

        string? answer = await JS.InvokeAsync<string?>(identifier: "prompt", $"Type 'y' to confirm deleting '{_item.Name}':");

        if (string.Equals(answer, "y", StringComparison.OrdinalIgnoreCase) == false)
        {
            return;
        }

        _isSaving = true;
        _error = string.Empty;

        try
        {
            Session.Vault.Items.Remove(_item);

            // Serialize entire vault and persist to all write connectors.
            var results = await Session.SaveVaultAsync();
            var failures = results.Where(r => r.Success == false).ToList();

            if (failures.Count > 0)
            {
                _error = "Partial save failure: " + string.Join(", ", failures.Select(f => $"{f.Connector.Name}: {f.Error}"));
                // Attempt to revert memory state because persistence failed
                Session.Vault.Items.Add(_item);
                Session.Vault.Items.Sort((a, b) => StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name));
                return;
            }

            Nav.NavigateTo("/vault");
        }
        catch (Exception ex)
        {
            _error = $"Delete failed: {ex.Message}";
            // Attempt to revert memory state
            if (Session.Vault is not null && Session.Vault.Items.Contains(_item) == false)
            {
                Session.Vault.Items.Add(_item);
                Session.Vault.Items.Sort((a, b) => StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name));
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/vault");
    }
}
