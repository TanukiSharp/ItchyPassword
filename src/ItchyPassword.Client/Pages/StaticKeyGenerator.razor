@page "/static-key"
@using ItchyPassword.Client.Services
@using ItchyPassword.Core.Services
@using ItchyPassword.Core.Helpers
@inject ICryptoService Crypto
@inject ClientVaultState State
@inject NavigationManager Nav

<div style="max-width: 800px; margin: 0 auto; padding: 1rem;">
    <div style="margin-bottom: 2rem;">
        <h2 style="margin: 0;">Static Key</h2>
        <p style="margin: 0; color: var(--text-muted);">Generate passwords deterministically using only your <strong>master key</strong> and a public part.</p>
    </div>

    @if (State.HasMasterKey == false)
    {
        <div class="alert warning">
            You must enter your Master Key first.
            <button class="button small secondary" style="margin-top: 0.5rem;" @onclick="GoToLogin">Enter Master Key</button>
        </div>
    }
    else
    {
        <div>
            <div class="form-group">
                <label for="publicPart">Public part</label>
                <input class="input" id="publicPart" type="text" value="@publicPart" @oninput="OnPublicPartInput" placeholder="e.g. google.com" required autofocus />
            </div>

            <div class="form-group">
                <label>Encoding</label>
                <select class="input" value="@encodingVersion" @onchange="OnEncodingVersionChange">
                    <option value="base58">Base58</option>
                    <option value="legacy">Legacy</option>
                </select>
            </div>

            <details>
                <summary style="cursor: pointer; margin-bottom: 1rem; color: var(--text-muted); user-select: none;">Options (Length@(encodingVersion == "legacy" ? ", Alphabet" : ""))</summary>
                <div style="padding: 1rem; border: 1px solid var(--border-color); border-radius: 4px; margin-bottom: 1rem;">
                    @if (encodingVersion == "legacy")
                    {
                        <div class="form-group">
                            <label>Alphabet</label>
                            <input class="input" type="text" value="@alphabet" @oninput="OnAlphabetInput" />
                        </div>
                    }

                    <div class="form-group">
                        <label>Length</label>
                        <input class="input" type="number" value="@length" @oninput="OnLengthInput" min="4" max="128" />
                    </div>
                </div>
            </details>
        </div>

        @if (string.IsNullOrWhiteSpace(result) == false)
        {
            <div class="form-group" style="margin-top: 2rem;">
                <label>Result</label>
                <div style="display: flex; gap: 0.5rem; align-items: start; position: relative;">
                   <input class="input" type="text" readonly value="@result" id="resultBox" style="font-family: monospace; font-size: 1.1em; letter-spacing: 0.05em; flex-grow: 1; margin-bottom: 0; min-height: 2.5rem;" />

                   <CopyButton Text="@result" />
                </div>
            </div>
        }

        @if (string.IsNullOrWhiteSpace(error) == false)
        {
             <div class="alert danger" style="margin-top: 1rem;">@error</div>
        }
    }
</div>

@code {
    private string publicPart = "";
    private int length = 64;
    private string alphabet = VaultMigrationService.DefaultAlphabet;
    private string encodingVersion = "base58";
    private string result = "";
    private string error = "";


    private void GoToLogin()
    {
        Nav.NavigateTo("/");
    }

    private async Task OnPublicPartInput(ChangeEventArgs e)
    {
        publicPart = e.Value?.ToString() ?? "";
        await GenerateAsync();
    }

    private async Task OnLengthInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            length = val;
            await GenerateAsync();
        }
    }

    private async Task OnAlphabetInput(ChangeEventArgs e)
    {
        alphabet = e.Value?.ToString() ?? "";
        await GenerateAsync();
    }

    private async Task OnEncodingVersionChange(ChangeEventArgs e)
    {
        encodingVersion = e.Value?.ToString() ?? "base58";
        await GenerateAsync();
    }

    private async Task GenerateAsync()
    {
        if (State.HasMasterKey == false)
        {
            error = "Master Key is missing. Please go back to login.";
            return;
        }

        if (string.IsNullOrEmpty(publicPart))
        {
            result = "";
            return;
        }

        if (encodingVersion == "legacy" && (string.IsNullOrEmpty(alphabet) || alphabet.Length < 2))
        {
            result = "";
            return;
        }

        error = "";

        try
        {
            byte[] mkBytes = System.Text.Encoding.UTF8.GetBytes(State.MasterKey);
            byte[] partBytes = System.Text.Encoding.UTF8.GetBytes(publicPart);

            byte[] rawHashBytes = await Crypto.GeneratePasswordV2Async(mkBytes, partBytes);

            string encoded;

            if (encodingVersion == "legacy")
            {
                encoded = BaseN.EncodeOneWay(rawHashBytes, alphabet);
            }
            else
            {
                encoded = Base58.Encode(rawHashBytes);
            }

            if (encoded.Length > length)
            {
                result = encoded[..length];
            }
            else
            {
                result = encoded;
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }
}
