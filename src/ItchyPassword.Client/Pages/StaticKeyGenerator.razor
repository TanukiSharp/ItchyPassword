@page "/static-key"
@using ItchyPassword.Client.Services
@using ItchyPassword.Core.Services
@using ItchyPassword.Core.Encoding
@inject ICryptoService Crypto
@inject IMasterKeyProvider MasterKeyProvider
@inject NavigationManager Nav

<PageTitle>Static Key Generator</PageTitle>

<h1>Static Key</h1>

<div class="card page-container">
    <div class="card-header">
        <h2>Generator</h2>
        <p class="text-muted">Generate passwords deterministically using only your <strong>master key</strong> and a public part.</p>
    </div>

    <div class="card-body">
        @if (MasterKeyProvider.HasMasterKey == false)
        {
            <div class="alert warning">
                You must enter your Master Key first.
                <button class="button small secondary" @onclick="GoToLogin">Enter Master Key</button>
            </div>
        }
        else
        {
            <div>
                <div class="form-group">
                    <label for="publicPart">Public part</label>
                    <input class="input" id="publicPart" type="text" value="@publicPart" @oninput="OnPublicPartInput" placeholder="e.g. google.com" required autofocus />
                </div>

                <details>
                    <summary class="details-summary">Options</summary>
                    <div class="options-panel">
                        <div class="form-group">
                            <label>Alphabet</label>
                            <input class="input" type="text" value="@alphabet" @oninput="OnAlphabetInput" />
                        </div>

                        <div class="form-group">
                            <label>Length</label>
                            <input class="input" type="number" value="@length" @oninput="OnLengthInput" min="4" max="128" />
                        </div>

                        <label>Crypto version</label>
                        <select class="input" value="@cryptoVersion" @onchange="OnCryptoVersionChange">
                            <option value="v2">v2</option>
                            <option value="v1">v1 (Legacy)</option>
                        </select>

                        <label>Encoding</label>
                        <select class="input" value="@encoding" @onchange="OnEncodingChange">
                            <option value="v2">v2</option>
                            <option value="v1">v1 (Legacy)</option>
                        </select>
                    </div>
                </details>
            </div>

            @if (string.IsNullOrWhiteSpace(result) == false)
            {
                <div class="form-group result-section">
                    <label>Result</label>
                    <div class="input-with-action">
                       <input class="input result-input" type="text" readonly value="@result" id="resultBox" />

                       <CopyButton Text="@result" />
                    </div>
                </div>
            }

            @if (string.IsNullOrWhiteSpace(error) == false)
            {
                 <div class="alert danger alert-inline">@error</div>
            }
        }
    </div>
</div>

@code {
    private string publicPart = "";
    private int length = 64;
    private string alphabet = VaultMigrationService.DefaultAlphabet;
    private string cryptoVersion = "v2";
    private string encoding = "v2";
    private string result = "";
    private string error = "";

    private void GoToLogin()
    {
        Nav.NavigateTo("/");
    }

    private async Task OnPublicPartInput(ChangeEventArgs e)
    {
        publicPart = e.Value?.ToString() ?? "";
        await GenerateAsync();
    }

    private async Task OnLengthInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            length = val;
            await GenerateAsync();
        }
    }

    private async Task OnAlphabetInput(ChangeEventArgs e)
    {
        alphabet = e.Value?.ToString() ?? "";
        await GenerateAsync();
    }

    private async Task OnCryptoVersionChange(ChangeEventArgs e)
    {
        cryptoVersion = e.Value?.ToString() ?? "v2";
        await GenerateAsync();
    }

    private async Task OnEncodingChange(ChangeEventArgs e)
    {
        encoding = e.Value?.ToString() ?? "v2";
        await GenerateAsync();
    }

    private async Task GenerateAsync()
    {
        if (MasterKeyProvider.HasMasterKey == false)
        {
            error = "Master Key is missing. Please go back to login.";
            return;
        }

        if (string.IsNullOrEmpty(publicPart))
        {
            result = "";
            return;
        }

        if (string.IsNullOrEmpty(alphabet) || alphabet.Length < 2)
        {
            result = "";
            return;
        }

        error = "";

        try
        {
            byte[] mkBytes = System.Text.Encoding.UTF8.GetBytes(MasterKeyProvider.MasterKey);
            byte[] partBytes = System.Text.Encoding.UTF8.GetBytes(publicPart);

            byte[] rawHashBytes;

            string encoded;

            if (cryptoVersion == "v1")
            {
                rawHashBytes = await Crypto.GeneratePasswordV1Async(mkBytes, partBytes);
            }
            else // v2
            {
                rawHashBytes = await Crypto.GeneratePasswordV2Async(mkBytes, partBytes);
            }

            if (encoding == "v1")
            {
                encoded = BaseN.EncodeOneWay(rawHashBytes, alphabet);
            }
            else // v2
            {
                encoded = BaseN.Encode(rawHashBytes, alphabet);
            }

            if (encoded.Length > length)
            {
                result = encoded[..length];
            }
            else
            {
                result = encoded;
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }
}
