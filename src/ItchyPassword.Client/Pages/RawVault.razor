@page "/raw-vault"
@using ItchyPassword.Core.Services
@inject VaultSession Session
@inject IAppState AppState
@inject NavigationManager Nav

@if (AppState.Status != AppStatus.Loaded || Session.Vault is null)
{
    <div class="page-centered">
        <p>Vault is not loaded.</p>
        <button class="button secondary" @onclick="GoHome">Back to login</button>
    </div>
}
else
{
    <div class="card page-container">
        <div class="card-header">
            <h3 class="heading-flush">Raw vault</h3>
            <span class="text-muted">Debug view — shows vault data as-is (secrets remain encrypted).</span>
        </div>

        <div class="card-body">
            <pre class="raw-vault-json">@(Session.LastRawContent ?? "(no content)")</pre>

            <div class="form-actions form-actions-spread">
                <span class="text-muted ml-auto">@(ByteSizeFormat.ToHumanReadable(Session.LastRawContent?.Length ?? 0))</span>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        if (AppState.Status != AppStatus.Loaded)
        {
            Nav.NavigateTo(Nav.BaseUri);
        }
    }

    private void GoHome()
    {
        Nav.NavigateTo(Nav.BaseUri);
    }
}
