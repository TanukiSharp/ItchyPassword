@page "/settings"
@using ItchyPassword.Client.Services
@using ItchyPassword.Client.Services.VaultConnectors
@using ItchyPassword.Core.Services
@using ItchyPassword.Client.Components
@using System.Web
@implements IDisposable
@inject VaultSession Session
@inject IAppState AppState
@inject IMasterKeyProvider MasterKeyProvider
@inject NavigationManager Nav

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

@if (string.IsNullOrWhiteSpace(redirectMessage) == false)
{
    <div class="alert danger settings-alert">@redirectMessage</div>
}

<div class="card page-container">
    <div class="card-header">
        <h2>Vault Connectors</h2>
        <p class="text-muted">Configure where your vault is stored. You can write to multiple locations for backup.</p>
    </div>

    <div class="card-body">
        @foreach (IVaultConnector connector in Session.Connectors)
        {
            <div class="connector-card">
                <div class="connector-header">
                    <h3 class="heading-flush">@connector.Name</h3>
                    <div class="connector-options">
                        <label title="Read from this source" class="inline-label">
                            <input type="radio" name="readSource" checked="@(Session.ReaderId == connector.Id)" @onchange="@(() => SetReader(connector))" /> Read
                        </label>
                        <label title="Write to this source" class="inline-label">
                            <input type="checkbox" checked="@Session.IsWriter(connector.Id)" disabled="@(Session.IsWriter(connector.Id) && (Session.ReaderId == connector.Id || Session.WriteConnectors.Count() == 1))" @onchange="@((ChangeEventArgs e) => SetWriter(connector, (bool)e.Value!))" /> Write
                        </label>
                    </div>
                </div>
                <p class="text-muted connector-description">@connector.Description</p>

                <hr class="section-divider-dashed" />

                <details>
                    <summary class="details-summary">Configuration</summary>

                    <VaultConnectorSettings Connector="connector" />

                    <div class="connector-test">
                        <button class="button secondary small" @onclick="@(() => TestAccessAsync(connector))">Test access</button>
                        @if (testResults.TryGetValue(connector, out (bool? Success, string Message) result))
                        {
                            <span class="@(result.Success is null ? "" : result.Success.Value ? "text-success" : "text-danger") test-result">
                                @result.Message
                            </span>
                        }
                    </div>
                </details>
            </div>
        }

        <div class="settings-actions">
            @if (CanUnlock)
            {
                <button class="button primary" disabled="@isUnlocking" @onclick="UnlockAndGo">
                    @if (isUnlocking)
                    {
                        <span>Unlocking...</span>
                    }
                    else
                    {
                        <span>Unlock & Go to Vault</span>
                    }
                </button>
            }

            @if (string.IsNullOrWhiteSpace(actionMessage) == false)
            {
                <span class="@(isActionError ? "text-danger" : "text-success")">@actionMessage</span>
            }
        </div>
    </div>
</div>

@code {
    private Dictionary<IVaultConnector, (bool? Success, string Message)> testResults = new();
    private string redirectMessage = string.Empty;

    // Use AppState for status message in case unlocking fails here.
    private string actionMessage => AppState.Status == AppStatus.Error ? AppState.StatusMessage : string.Empty;
    private bool isActionError => AppState.Status == AppStatus.Error;

    private bool isUnlocking => AppState.Status == AppStatus.Unlocking || AppState.Status == AppStatus.LoadingVault;

    private bool CanUnlock => MasterKeyProvider.HasMasterKey;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Check for a redirect message in the query string.
        var uri = new Uri(Nav.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        string? message = query["message"];

        if (string.IsNullOrWhiteSpace(message) == false)
        {
            redirectMessage = message;
        }

        foreach (IVaultConnector connector in Session.Connectors)
        {
            await connector.LoadConfigurationAsync(CancellationToken.None);
        }
    }

    private async Task SetReader(IVaultConnector connector)
    {
        Session.ReaderId = connector.Id;
        await Session.SaveReaderAsync(CancellationToken.None);

        // Automatically enable as a writer when selected for read.
        if (Session.IsWriter(connector.Id) == false)
        {
            Session.SetWriter(connector.Id, true);
            await Session.SaveWritersAsync(CancellationToken.None);
        }
    }

    private async Task SetWriter(IVaultConnector connector, bool enabled)
    {
        Session.SetWriter(connector.Id, enabled);
        await Session.SaveWritersAsync(CancellationToken.None);
    }

    private async Task TestAccessAsync(IVaultConnector connector)
    {
        // Call AccessAsync before any await to let the connector's synchronous
        // preamble run on the click call-stack (preserving the browser gesture).
        Task<bool> accessTask = connector.AccessAsync(CancellationToken.None);

        testResults[connector] = (null, "Testing...");
        StateHasChanged();

        bool success = await accessTask;
        testResults[connector] = (success, success ? "Access granted." : "Access denied.");
        StateHasChanged();
    }

    private async Task UnlockAndGo()
    {
        // Try to unlock via AppState.
        // Note: AppState.RetryUnlockAsync calls Session.UnlockAsync.
        // Session.UnlockAsync calls Connector.AccessAsync.
        // For LocalFileVaultConnector (FileSystem Access API), AccessAsync must be called
        // within the synchronous execution of the click handler (user activation).
        // Since we pre-loaded configuration in OnInitializedAsync, Session.UnlockAsync
        // should reach AccessAsync synchronously, preserving the activation.

        await AppState.RetryUnlockAsync(CancellationToken.None);
    }
}
