@page "/settings"
@using ItchyPassword.Client.Services
@using ItchyPassword.Client.Services.VaultConnectors
@using ItchyPassword.Core.Services
@using ItchyPassword.Client.Components
@using System.Web
@implements IDisposable
@inject VaultSession Session
@inject IAppState AppState
@inject IMasterKeyProvider MasterKeyProvider
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

@if (string.IsNullOrWhiteSpace(redirectMessage) == false)
{
    <div class="alert danger settings-alert">@redirectMessage</div>
}

<div class="card page-container">
    <div class="card-header">
        <h2>Vault connectors</h2>
        <p class="text-muted">Configure where your vault is stored. Only one connector is active at a time.</p>
    </div>

    <div class="card-body">
        @if (IsNotLoaded)
        {
            <p class="text-muted">Load the vault to switch between connectors.</p>
        }

        @foreach (IVaultConnector connector in Session.Connectors)
        {
            bool isActive = Session.IsActiveConnector(connector.Id);
            IVaultConnector captured = connector;

            <div class="connector-card">
                <div class="connector-header">
                    <h3 class="heading-flush">@connector.Name</h3>
                    <div class="connector-role-controls">
                        @if (_busyConnector == captured)
                        {
                            <div class="loading-spinner-sm"></div>
                        }

                        @if (isActive)
                        {
                            <span class="badge active">✓ Active</span>
                        }
                        else if (IsNotLoaded == false)
                        {
                            <button class="button primary small"
                                    disabled="@(_busyConnector is not null)"
                                    @onclick="@(() => ActivateConnectorAsync(captured))">
                                Activate
                            </button>
                        }
                    </div>
                </div>
                <p class="text-muted connector-description">@connector.Description</p>

                <hr class="section-divider-dashed" />

                <details>
                    <summary class="details-summary">Configuration</summary>

                    <VaultConnectorSettings Connector="connector" />

                    <div class="connector-test">
                        @if (_busyConnector == captured)
                        {
                            <button type="button" class="button danger small" @onclick="CancelTestAccess">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="button primary small" disabled="@(_busyConnector is not null)" @onclick="@(() => TestAccessAsync(connector))">Test access</button>
                        }
                        <button type="button" class="button secondary small" disabled="@(_busyConnector is not null)" @onclick="@(() => ClearConnectorAsync(captured, VaultConnectorClearType.Cache))">Clear cache</button>
                        <button type="button" class="button danger small" disabled="@(_busyConnector is not null)" @onclick="@(() => ClearConnectorAsync(captured, VaultConnectorClearType.All))">Clear all</button>
                        @if (testResults.TryGetValue(connector.Id, out (bool? Success, string Message) result))
                        {
                            <span class="@(result.Success is null ? "" : result.Success.Value ? "text-success" : "text-danger") test-result">
                                @result.Message
                            </span>
                        }
                    </div>
                </details>
            </div>
        }

        <div class="settings-actions">
            @if (CanLoad)
            {
                <button class="button primary" disabled="@(isLoading || _busyConnector is not null)" @onclick="LoadAndGo">
                    @if (isLoading)
                    {
                        <span>Loading...</span>
                    }
                    else
                    {
                        <span>Load and go to vault</span>
                    }
                </button>
            }

            @if (string.IsNullOrWhiteSpace(actionMessage) == false)
            {
                <span class="@(isActionError ? "text-danger" : "text-success")">@actionMessage</span>
            }
        </div>
    </div>
</div>

<ConfirmationModal IsVisible="@modalVisible"
                   Title="@modalTitle"
                   Message="@modalMessage"
                   Actions="@modalActions"
                   OnCancel="@DismissModal" />

@code {
    private Dictionary<Guid, (bool? Success, string Message)> testResults = new();
    private string redirectMessage = string.Empty;
    private IVaultConnector? _busyConnector;
    private CancellationTokenSource? _accessCts;

    // Modal state.
    private bool modalVisible;
    private string modalTitle = string.Empty;
    private string modalMessage = string.Empty;
    private List<ModalAction> modalActions = [];

    // Use AppState for status message in case loading fails here.
    private string actionMessage => AppState.Status == AppStatus.Error ? AppState.StatusMessage : string.Empty;
    private bool isActionError => AppState.Status == AppStatus.Error;

    private bool isLoading => AppState.Status == AppStatus.Loading || AppState.Status == AppStatus.LoadingVault;

    private bool CanLoad => MasterKeyProvider.HasMasterKey;
    private bool IsNotLoaded => MasterKeyProvider.HasMasterKey == false;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        _accessCts?.Cancel();
        _accessCts?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        // Check for a redirect message in the query string.
        var uri = new Uri(Nav.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        string? message = query["message"];

        if (string.IsNullOrWhiteSpace(message) == false)
        {
            redirectMessage = message;
        }

        foreach (IVaultConnector connector in Session.Connectors)
        {
            await connector.LoadConfigurationAsync(CancellationToken.None);
        }
    }

    /// <summary>
    /// Switches the active connector. Always warns the user that data on the
    /// new connector may differ and existing unsaved changes could be lost.
    /// </summary>
    private async Task ActivateConnectorAsync(IVaultConnector connector)
    {
        if (Session.IsActiveConnector(connector.Id))
        {
            return;
        }

        modalTitle = "Switch vault";
        modalMessage = $"How would you like to initialize the vault for {connector.Name}?";
        modalActions = [];

        if (Session.Vault is not null)
        {
            modalActions.Add(new ModalAction(
                $"Export to {connector.Name}",
                $"Overwrite data in {connector.Name} vault with the current data of the application.",
                "button danger",
                async () =>
                {
                    try
                    {
                        Session.SetActiveConnector(connector.Id);
                        await Session.SaveActiveConnectorAsync(CancellationToken.None);

                        var (success, error) = await Session.SaveVaultAsync($"Exported vault to {connector.Name}", CancellationToken.None);
                        if (success)
                        {
                            Toast.Show($"Successfully exported vault to {connector.Name}", TimeSpan.FromSeconds(5));
                            await AppState.RetryLoadAsync(CancellationToken.None);
                        }
                        else
                        {
                            Toast.Show($"Failed to export: {error}", TimeSpan.FromSeconds(5));
                        }
                    }
                    catch (Exception ex)
                    {
                        Toast.Show($"Failed to export: {ex.Message}", TimeSpan.FromSeconds(5));
                    }
                    finally
                    {
                        DismissModal();
                    }
                }
            ));
        }

        modalActions.Add(new ModalAction(
            $"Import from {connector.Name}",
            $"Load the vault stored in {connector.Name} in the application.",
            "button primary",
            async () =>
            {
                try
                {
                    Session.SetActiveConnector(connector.Id);
                    await Session.SaveActiveConnectorAsync(CancellationToken.None);
                    await AppState.RetryLoadAsync(CancellationToken.None);
                }
                catch (Exception ex)
                {
                    Toast.Show($"Failed to switch: {ex.Message}", TimeSpan.FromSeconds(5));
                }
                finally
                {
                    DismissModal();
                }
            }
        ));

        modalVisible = true;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void DismissModal()
    {
        modalVisible = false;
        _busyConnector = null;
        modalTitle = string.Empty;
        modalMessage = string.Empty;
        modalActions = [];
        StateHasChanged();
    }

    private async Task TestAccessAsync(IVaultConnector connector)
    {
        _accessCts?.Cancel();
        _accessCts?.Dispose();
        _accessCts = new CancellationTokenSource();
        CancellationToken token = _accessCts.Token;

        // Call AccessAsync before any await to let the connector's synchronous
        // preamble run on the click call-stack (preserving the browser gesture).
        Task<bool> accessTask = connector.AccessAsync(token);

        _busyConnector = connector;
        testResults[connector.Id] = (null, "Testing...");
        StateHasChanged();

        try
        {
            bool hasAccess = await accessTask;

            testResults[connector.Id] = hasAccess
                ? (true, "Access granted.")
                : (false, "Access denied. " + connector.AccessFailureMessage);
        }
        catch (OperationCanceledException)
        {
            testResults[connector.Id] = (null, "Cancelled.");
        }

        _busyConnector = null;
        StateHasChanged();
    }

    private void CancelTestAccess()
    {
        _accessCts?.Cancel();
    }

    private async Task LoadAndGo()
    {
        await AppState.RetryLoadAsync(CancellationToken.None);
    }

    private async Task ClearConnectorAsync(IVaultConnector connector, VaultConnectorClearType clearType)
    {
        await connector.ClearAsync(clearType);
        string label = clearType == VaultConnectorClearType.All ? "All data" : "Cache";
        Toast.Show($"{connector.Name}: {label} cleared.", TimeSpan.FromSeconds(3));
    }
}
