@page "/settings"
@using ItchyPassword.Client.Services
@using ItchyPassword.Client.Services.VaultConnectors
@using ItchyPassword.Client.Components
@using System.Web
@inject ClientVaultState State
@inject NavigationManager Nav

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

@if (string.IsNullOrWhiteSpace(redirectMessage) == false)
{
    <div class="alert danger settings-alert">@redirectMessage</div>
}

<div class="card page-container">
    <div class="card-header">
        <h2>Vault Connectors</h2>
        <p class="text-muted">Configure where your vault is stored. You can write to multiple locations for backup.</p>
    </div>

    <div class="card-body">
        @foreach (IVaultConnector connector in State.Connectors)
        {
            <div class="connector-card">
                <div class="connector-header">
                    <h3 class="heading-flush">@connector.Name</h3>
                    <div class="connector-options">
                        <label title="Read from this source" class="inline-label">
                            <input type="radio" name="readSource" checked="@(State.ActiveReaderId == connector.Id)" @onchange="@(() => SetReader(connector))" /> Read
                        </label>
                        <label title="Write to this source" class="inline-label">
                            <input type="checkbox" checked="@State.IsWriter(connector.Id)" disabled="@(State.IsWriter(connector.Id) && State.WriteConnectors.Count() == 1)" @onchange="@((ChangeEventArgs e) => SetWriter(connector, (bool)e.Value!))" /> Write
                        </label>
                    </div>
                </div>
                <p class="text-muted connector-description">@connector.Description</p>

                <hr class="section-divider-dashed" />

                <details>
                    <summary class="details-summary">Configuration</summary>

                    <VaultConnectorSettings Connector="connector" />

                    <div class="connector-test">
                        <button class="button secondary small" @onclick="@(() => TestConnection(connector))">Test Connection</button>
                        @if (testResults.TryGetValue(connector, out (bool? Success, string Message) result))
                        {
                            <span class="@(result.Success is null ? "" : result.Success.Value ? "text-success" : "text-danger") test-result">
                                @result.Message
                            </span>
                        }
                    </div>
                </details>
            </div>
        }

        <div class="settings-actions">
            @if (CanUnlock)
            {
                <button class="button primary" disabled="@isUnlocking" @onclick="UnlockAndGo">
                    @if (isUnlocking)
                    {
                        <span>Unlocking...</span>
                    }
                    else
                    {
                        <span>Unlock & Go to Vault</span>
                    }
                </button>
            }

            @if (string.IsNullOrWhiteSpace(actionMessage) == false)
            {
                <span class="@(isActionError ? "text-danger" : "text-success")">@actionMessage</span>
            }
        </div>
    </div>
</div>

@code {
    private Dictionary<IVaultConnector, (bool? Success, string Message)> testResults = new();
    private string redirectMessage = string.Empty;
    private string actionMessage = string.Empty;
    private bool isActionError = false;

    private bool isUnlocking = false;

    private bool CanUnlock => string.IsNullOrWhiteSpace(State.MasterKey) == false;

    protected override async Task OnInitializedAsync()
    {
        // Check for a redirect message in the query string.
        var uri = new Uri(Nav.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        string? message = query["message"];

        if (string.IsNullOrWhiteSpace(message) == false)
        {
            redirectMessage = message;
        }

        foreach (IVaultConnector connector in State.Connectors)
        {
            await connector.LoadConfigurationAsync();
        }
    }

    private async Task SetReader(IVaultConnector connector)
    {
        State.ActiveReaderId = connector.Id;
        await State.SaveActiveReaderAsync();
    }

    private async Task SetWriter(IVaultConnector connector, bool enabled)
    {
        State.SetWriter(connector.Id, enabled);
        await State.SaveWritersAsync();
    }

    private async Task TestConnection(IVaultConnector connector)
    {
        // Call ConnectAsync before any await to let the connector's synchronous
        // preamble run on the click call-stack (preserving the browser gesture).
        Task<bool> connectTask = connector.ConnectAsync();

        testResults[connector] = (null, "Testing...");
        StateHasChanged();

        bool success = await connectTask;
        testResults[connector] = (success, success ? "Connected successfully." : "Connection failed.");
        StateHasChanged();
    }

    private async Task UnlockAndGo()
    {
        if (State.ReadConnector is null || State.ReadConnector.IsConfigured == false)
        {
            actionMessage = "Please configure the selected vault connector reader first.";
            isActionError = true;
            return;
        }

        // Call ConnectAsync before any await to let the connector's synchronous
        // preamble run on the click call-stack (preserving the browser gesture).
        Task<bool> connectTask = State.ReadConnector.ConnectAsync();

        isUnlocking = true;
        actionMessage = "Connecting to unlock...";
        isActionError = false;
        redirectMessage = string.Empty;
        StateHasChanged();

        try
        {
            bool isConnected = await connectTask;

            if (isConnected == false)
            {
                actionMessage = $"Failed to connect to {State.ReadConnector.Name}.";
                isActionError = true;
                return;
            }

            string content = await State.ReadConnector.LoadVaultAsync();

            if (string.IsNullOrWhiteSpace(content))
            {
                State.Vault = new ItchyPassword.Core.Models.VaultV2() { Version = 2, Items = [] };
            }
            else
            {
                State.Vault = VaultDataService.DeserializeVault(content);
            }

            Nav.NavigateTo("/vault");
        }
        catch (Exception ex)
        {
            actionMessage = $"Error unlocking: {ex.Message}";
            isActionError = true;
        }
        finally
        {
            isUnlocking = false;
        }
    }
}
