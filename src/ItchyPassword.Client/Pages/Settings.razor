@page "/settings"
@using ItchyPassword.Client.Services
@using ItchyPassword.Client.Services.VaultConnectors
@using ItchyPassword.Core.Services
@using ItchyPassword.Client.Components
@using System.Web
@implements IDisposable
@inject VaultSession Session
@inject IAppState AppState
@inject IMasterKeyProvider MasterKeyProvider
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

@if (string.IsNullOrWhiteSpace(redirectMessage) == false)
{
    <div class="alert danger settings-alert">@redirectMessage</div>
}

<div class="card page-container">
    <div class="card-header">
        <h2>Vault Connectors</h2>
        <p class="text-muted">Configure where your vault is stored. You can write to multiple locations for backup.</p>
    </div>

    <div class="card-body">
        @if (IsLocked)
        {
            <p class="text-muted">Unlock the vault to change connector roles.</p>
        }

        @foreach (IVaultConnector connector in Session.Connectors)
        {
            ConnectorRole currentRole = GetRole(connector);
            IVaultConnector captured = connector;

            <div class="connector-card">
                <div class="connector-header">
                    <h3 class="heading-flush">@connector.Name</h3>
                    <RichSelect TValue="ConnectorRole"
                                Value="@currentRole"
                                Options="@BuildRoleOptions(connector, currentRole)"
                                Disabled="@(IsLocked || isBusy)"
                                ValueChanged="@(role => SetRoleAsync(captured, role))" />
                </div>
                <p class="text-muted connector-description">@connector.Description</p>

                <hr class="section-divider-dashed" />

                <details>
                    <summary class="details-summary">Configuration</summary>

                    <VaultConnectorSettings Connector="connector" />

                    <div class="connector-test">
                        <button class="button secondary small" disabled="@isBusy" @onclick="@(() => TestAccessAsync(connector))">Test access</button>
                        @if (testResults.TryGetValue(connector.Id, out (bool? Success, string Message) result))
                        {
                            <span class="@(result.Success is null ? "" : result.Success.Value ? "text-success" : "text-danger") test-result">
                                @result.Message
                            </span>
                        }
                    </div>
                </details>
            </div>
        }

        <div class="settings-actions">
            @if (CanUnlock)
            {
                <button class="button primary" disabled="@(isUnlocking || isBusy)" @onclick="UnlockAndGo">
                    @if (isUnlocking)
                    {
                        <span>Unlocking...</span>
                    }
                    else
                    {
                        <span>Unlock & Go to Vault</span>
                    }
                </button>
            }

            @if (string.IsNullOrWhiteSpace(actionMessage) == false)
            {
                <span class="@(isActionError ? "text-danger" : "text-success")">@actionMessage</span>
            }
        </div>
    </div>
</div>

<ConfirmationModal IsVisible="@modalVisible"
                   Title="@modalTitle"
                   Message="@modalMessage"
                   Actions="@modalActions"
                   OnCancel="@DismissModal">
    <AdditionalContent>
        @if (string.IsNullOrWhiteSpace(modalHint) == false)
        {
            <p class="modal-read-only-hint">@modalHint</p>
        }
    </AdditionalContent>
</ConfirmationModal>

@code {
    private Dictionary<Guid, (bool? Success, string Message)> testResults = new();
    private Dictionary<Guid, ConnectorAccessResult> lastAccessResults = new();
    private string redirectMessage = string.Empty;
    private bool isBusy;

    // Modal state.
    private bool modalVisible;
    private string modalTitle = string.Empty;
    private string modalMessage = string.Empty;
    private string modalHint = string.Empty;
    private List<ModalAction> modalActions = [];

    // Use AppState for status message in case unlocking fails here.
    private string actionMessage => AppState.Status == AppStatus.Error ? AppState.StatusMessage : string.Empty;
    private bool isActionError => AppState.Status == AppStatus.Error;

    private bool isUnlocking => AppState.Status == AppStatus.Unlocking || AppState.Status == AppStatus.LoadingVault;

    private bool CanUnlock => MasterKeyProvider.HasMasterKey;
    private bool IsLocked => MasterKeyProvider.HasMasterKey == false;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Check for a redirect message in the query string.
        var uri = new Uri(Nav.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        string? message = query["message"];

        if (string.IsNullOrWhiteSpace(message) == false)
        {
            redirectMessage = message;
        }

        foreach (IVaultConnector connector in Session.Connectors)
        {
            await connector.LoadConfigurationAsync(CancellationToken.None);
        }
    }

    /// <summary>
    /// Returns the current role of a connector from session state.
    /// </summary>
    private ConnectorRole GetRole(IVaultConnector connector)
    {
        return Session.GetRole(connector.Id);
    }

    /// <summary>
    /// Builds the dropdown options for a connector, with contextual hints and disabled states.
    /// </summary>
    private List<RichSelectOption<ConnectorRole>> BuildRoleOptions(IVaultConnector connector, ConnectorRole currentRole)
    {
        bool hasAccess = lastAccessResults.TryGetValue(connector.Id, out ConnectorAccessResult access);

        // Main option.
        bool mainDisabled = currentRole == ConnectorRole.Main;
        string mainHint = "Read and write — your primary vault";
        if (mainDisabled == false && hasAccess && access.CanRead == false)
        {
            mainDisabled = true;
            mainHint = "No read access — use Import instead";
        }
        else if (mainDisabled == false && hasAccess && access.CanWrite == false)
        {
            mainDisabled = true;
            mainHint = "Read-only — use Import to load data";
        }

        // Backup option.
        bool backupDisabled = false;
        string backupHint = "Write-only backup destination";
        if (currentRole == ConnectorRole.Main)
        {
            backupDisabled = true;
            backupHint = "Cannot downgrade — set another connector as Main first";
        }
        else if (hasAccess && access.CanWrite == false)
        {
            backupDisabled = true;
            backupHint = "No write access";
        }

        // Disabled option.
        bool disabledDisabled = false;
        string disabledHint = "Not used";
        if (currentRole == ConnectorRole.Main)
        {
            disabledDisabled = true;
            disabledHint = "Cannot disable — set another connector as Main first";
        }


        return
        [
            new RichSelectOption<ConnectorRole>(ConnectorRole.Main, "Main", mainHint, mainDisabled),
            new RichSelectOption<ConnectorRole>(ConnectorRole.Backup, "Backup", backupHint, backupDisabled),
            new RichSelectOption<ConnectorRole>(ConnectorRole.Disabled, "Disabled", disabledHint, disabledDisabled),
        ];
    }

    /// <summary>
    /// Handles a role change from the dropdown.
    /// </summary>
    private async Task SetRoleAsync(IVaultConnector connector, ConnectorRole newRole)
    {
        ConnectorRole currentRole = GetRole(connector);

        if (newRole == currentRole)
        {
            return;
        }

        switch (newRole)
        {
            case ConnectorRole.Main:
                await PromoteToMainAsync(connector);
                break;

            case ConnectorRole.Backup:
                if (currentRole == ConnectorRole.Disabled)
                {
                    await EnableBackupAsync(connector);
                }
                // Main → Backup is blocked by the dropdown (disabled option).
                break;

            case ConnectorRole.Disabled:
                Session.SetRole(connector.Id, ConnectorRole.Disabled);
                await Session.SaveRolesAsync(CancellationToken.None);
                break;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Promotes a connector to Main. Downgrades the old Main to Backup.
    /// </summary>
    private async Task PromoteToMainAsync(IVaultConnector connector)
    {
        // Shortcut: connector is already a Backup \u2014 vaults are in sync by design.
        if (Session.GetRole(connector.Id) == ConnectorRole.Backup)
        {
            await ApplyMainAsync(connector);
            return;
        }

        isBusy = true;
        StateHasChanged();

        try
        {
            await connector.LoadConfigurationAsync(CancellationToken.None);

            ConnectorAccessResult access = await connector.AccessAsync(CancellationToken.None);
            lastAccessResults[connector.Id] = access;

            if (access.CanRead == false || access.CanWrite == false)
            {
                Toast.Show($"Cannot set {connector.Name} as Main — requires read and write access.", TimeSpan.FromSeconds(5));
                return;
            }

            string remoteContent = await connector.LoadVaultAsync(CancellationToken.None);
            VaultComparisonResult comparison = VaultDataService.CompareVaultSignatures(Session.LastRawContent, remoteContent);

            switch (comparison.Status)
            {
                case VaultComparisonStatus.Identical:
                    await ApplyMainAsync(connector);
                    isBusy = false;
                    return;

                case VaultComparisonStatus.RemoteEmpty:
                    // Remote is empty — push current vault silently.
                    var pushResult = await Session.PushVaultToAsync(connector, $"Initial sync from {Session.MainConnector!.Name}", CancellationToken.None);
                    if (pushResult.Success == false)
                    {
                        Toast.Show($"Failed to sync to {connector.Name}: {pushResult.Error}", TimeSpan.FromSeconds(5));
                        return;
                    }
                    await ApplyMainAsync(connector);
                    isBusy = false;
                    return;

                case VaultComparisonStatus.LocalEmpty:
                    // Nothing local to lose — load remote vault.
                    await Session.LoadVaultFromContentAsync(remoteContent, CancellationToken.None);
                    await ApplyMainAsync(connector);
                    isBusy = false;
                    return;

                case VaultComparisonStatus.Different:
                    ShowMainConflictModal(connector, access, comparison, remoteContent);
                    return;
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error promoting to Main: {ex.Message}", TimeSpan.FromSeconds(5));
        }
        finally
        {
            if (modalVisible == false)
            {
                isBusy = false;
            }

            StateHasChanged();
        }
    }

    private void ShowMainConflictModal(
        IVaultConnector connector,
        ConnectorAccessResult access,
        VaultComparisonResult comparison,
        string remoteContent)
    {
        string remoteLabel = $"{comparison.RemoteItemCount} item(s)";
        string localLabel = comparison.LocalItemCount == 0
            ? "empty"
            : $"{comparison.LocalItemCount} item(s)";

        modalTitle = "Vault Data Conflict";
        modalMessage = $"Current vault: {localLabel}.\n{connector.Name}: {remoteLabel}.";
        modalHint = string.Empty;
        modalActions =
        [
            new ModalAction($"Use {connector.Name} vault data", "button danger", async () =>
            {
                try
                {
                    await Session.LoadVaultFromContentAsync(remoteContent, CancellationToken.None);
                    await ApplyMainAsync(connector);
                }
                catch (Exception ex)
                {
                    Toast.Show($"Failed to load remote vault: {ex.Message}", TimeSpan.FromSeconds(5));
                }
                finally
                {
                    DismissModal();
                }
            }),
            new ModalAction($"Overwrite {connector.Name} with current data", "button primary", async () =>
            {
                try
                {
                    var pushResult = await Session.PushVaultToAsync(connector, $"Overwrite from {Session.MainConnector!.Name} promotion", CancellationToken.None);
                    if (pushResult.Success == false)
                    {
                        Toast.Show($"Failed to overwrite {connector.Name}: {pushResult.Error}", TimeSpan.FromSeconds(5));
                        return;
                    }
                    await ApplyMainAsync(connector);
                }
                catch (Exception ex)
                {
                    Toast.Show($"Failed to overwrite: {ex.Message}", TimeSpan.FromSeconds(5));
                }
                finally
                {
                    DismissModal();
                }
            }),
        ];

        modalVisible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Applies the Main role. Old Main auto-downgrades to Backup (stays active).
    /// </summary>
    private async Task ApplyMainAsync(IVaultConnector connector)
    {
        Session.SetRole(connector.Id, ConnectorRole.Main);
        await Session.SaveRolesAsync(CancellationToken.None);
    }

    /// <summary>
    /// Enables a connector as a Backup writer with vault comparison.
    /// </summary>
    private async Task EnableBackupAsync(IVaultConnector connector)
    {
        isBusy = true;
        StateHasChanged();

        try
        {
            await connector.LoadConfigurationAsync(CancellationToken.None);

            ConnectorAccessResult access = await connector.AccessAsync(CancellationToken.None);
            lastAccessResults[connector.Id] = access;

            if (access.CanWrite == false)
            {
                Toast.Show($"No write access to {connector.Name}.", TimeSpan.FromSeconds(5));
                return;
            }

            // Write-only connector — cannot compare vaults.
            if (access.CanRead == false)
            {
                ShowWriteOnlyBackupModal(connector);
                return;
            }

            string remoteContent = await connector.LoadVaultAsync(CancellationToken.None);
            VaultComparisonResult comparison = VaultDataService.CompareVaultSignatures(Session.LastRawContent, remoteContent);

            switch (comparison.Status)
            {
                case VaultComparisonStatus.Identical:
                    Session.SetRole(connector.Id, ConnectorRole.Backup);
                    await Session.SaveRolesAsync(CancellationToken.None);
                    isBusy = false;
                    return;

                case VaultComparisonStatus.RemoteEmpty:
                    // Silent overwrite - no remote data to lose.
                    var pushResult = await Session.PushVaultToAsync(connector, "Initial sync from backup enable", CancellationToken.None);
                    if (pushResult.Success == false)
                    {
                        Toast.Show($"Failed to sync to {connector.Name}: {pushResult.Error}", TimeSpan.FromSeconds(5));
                        return;
                    }
                    Session.SetRole(connector.Id, ConnectorRole.Backup);
                    await Session.SaveRolesAsync(CancellationToken.None);
                    isBusy = false;
                    return;

                case VaultComparisonStatus.LocalEmpty:
                    ShowBackupOverwriteModal(connector, comparison, isLocalEmpty: true);
                    return;

                case VaultComparisonStatus.Different:
                    ShowBackupOverwriteModal(connector, comparison, isLocalEmpty: false);
                    return;
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error enabling backup: {ex.Message}", TimeSpan.FromSeconds(5));
        }
        finally
        {
            if (modalVisible == false)
            {
                isBusy = false;
            }

            StateHasChanged();
        }
    }

    private void ShowWriteOnlyBackupModal(IVaultConnector connector)
    {
        modalTitle = "Write-Only Connector";
        modalMessage = $"{connector.Name} is write-only — vault content cannot be compared. Enabling it as a backup will overwrite its current data with your current vault.";
        modalHint = string.Empty;
        modalActions =
        [
            new ModalAction($"Overwrite {connector.Name} with current data", "button danger", async () =>
            {
                try
                {
                    var pushResult = await Session.PushVaultToAsync(connector, "Write-only backup enable", CancellationToken.None);
                    if (pushResult.Success == false)
                    {
                        Toast.Show($"Failed to overwrite {connector.Name}: {pushResult.Error}", TimeSpan.FromSeconds(5));
                        return;
                    }
                    Session.SetRole(connector.Id, ConnectorRole.Backup);
                    await Session.SaveRolesAsync(CancellationToken.None);
                }
                catch (Exception ex)
                {
                    Toast.Show($"Failed to overwrite: {ex.Message}", TimeSpan.FromSeconds(5));
                }
                finally
                {
                    DismissModal();
                }
            }),
        ];

        modalVisible = true;
        StateHasChanged();
    }

    private void ShowBackupOverwriteModal(IVaultConnector connector, VaultComparisonResult comparison, bool isLocalEmpty)
    {
        string localLabel = isLocalEmpty ? "empty" : $"{comparison.LocalItemCount} item(s)";
        string remoteLabel = $"{comparison.RemoteItemCount} item(s)";
        string overwriteLabel = isLocalEmpty
            ? $"Overwrite {connector.Name} with current (empty) data"
            : $"Overwrite {connector.Name} with current data";

        modalTitle = "Vault Data Conflict";
        modalMessage = $"Current vault: {localLabel}.\n{connector.Name}: {remoteLabel}.";
        modalHint = string.Empty;
        modalActions =
        [
            new ModalAction(overwriteLabel, "button danger", async () =>
            {
                try
                {
                    var pushResult = await Session.PushVaultToAsync(connector, "Overwrite from backup enable", CancellationToken.None);
                    if (pushResult.Success == false)
                    {
                        Toast.Show($"Failed to overwrite {connector.Name}: {pushResult.Error}", TimeSpan.FromSeconds(5));
                        return;
                    }
                    Session.SetRole(connector.Id, ConnectorRole.Backup);
                    await Session.SaveRolesAsync(CancellationToken.None);
                }
                catch (Exception ex)
                {
                    Toast.Show($"Failed to overwrite: {ex.Message}", TimeSpan.FromSeconds(5));
                }
                finally
                {
                    DismissModal();
                }
            }),
        ];

        modalVisible = true;
        StateHasChanged();
    }

    private void DismissModal()
    {
        modalVisible = false;
        isBusy = false;
        modalTitle = string.Empty;
        modalMessage = string.Empty;
        modalHint = string.Empty;
        modalActions = [];
        StateHasChanged();
    }

    private async Task TestAccessAsync(IVaultConnector connector)
    {
        // Call AccessAsync before any await to let the connector's synchronous
        // preamble run on the click call-stack (preserving the browser gesture).
        Task<ConnectorAccessResult> accessTask = connector.AccessAsync(CancellationToken.None);

        isBusy = true;
        testResults[connector.Id] = (null, "Testing...");
        StateHasChanged();

        ConnectorAccessResult result = await accessTask;
        lastAccessResults[connector.Id] = result;

        if (result.CanRead && result.CanWrite)
        {
            testResults[connector.Id] = (true, "Read: ✓ | Write: ✓");
        }
        else if (result.CanRead)
        {
            testResults[connector.Id] = (true, "Read: ✓ | Write: ✗");
        }
        else if (result.CanWrite)
        {
            testResults[connector.Id] = (true, "Read: ✗ | Write: ✓");
        }
        else
        {
            testResults[connector.Id] = (false, "Access denied.");
        }

        isBusy = false;
        StateHasChanged();
    }

    private async Task UnlockAndGo()
    {
        await AppState.RetryUnlockAsync(CancellationToken.None);
    }
}
