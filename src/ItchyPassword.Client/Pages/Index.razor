@page "/"
@layout ItchyPassword.Client.Layout.EmptyLayout
@implements IDisposable
@inject VaultSession Session
@inject NavigationManager Nav

@if (Session.IsUnlocked == false)
{
    // If not unlocked, check if configured. If not configured, go to Setup. Else simple Master Key view.
    // For now, let's render MasterKeyView (Simple) which can link to setup.
    <MasterKeyView />
}

@code {
    protected override void OnInitialized()
    {
        if (Session.IsUnlocked)
        {
            NavigateToCorrectPage();
        }
        Session.PropertyChanged += OnStateChanged;
    }

    private void OnStateChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (Session.IsUnlocked)
        {
            NavigateToCorrectPage();
        }
    }

    private void NavigateToCorrectPage()
    {
        if (Session.Vault is not null)
        {
            Nav.NavigateTo("/vault");
        }
        else
        {
            Nav.NavigateTo("/settings");
        }
    }

    public void Dispose()
    {
        Session.PropertyChanged -= OnStateChanged;
    }
}
