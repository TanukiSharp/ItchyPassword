@page "/"
@layout ItchyPassword.Client.Layout.EmptyLayout
@implements IDisposable
@using ItchyPassword.Core.Services
@inject IAppState AppState
@inject NavigationManager Nav

@if (AppState.Status == AppStatus.NotLoaded)
{
    <MasterKeyView />
}

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
        CheckRedirect();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    private void CheckRedirect()
    {
        if (AppState.Status == AppStatus.Loaded || AppState.Status == AppStatus.Loading || AppState.Status == AppStatus.Error)
        {
            Nav.NavigateTo("vault");
        }
        else if (AppState.Status == AppStatus.SetupRequired)
        {
            Nav.NavigateTo("settings");
        }
    }
}

