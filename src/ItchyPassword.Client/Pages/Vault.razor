@page "/vault"
@using ItchyPassword.Client.Components
@using ItchyPassword.Client.Services
@using System.Web
@inject ClientVaultState State
@inject VaultUnlockService UnlockService
@inject NavigationManager Nav

@if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column;">
        <div class="loading-spinner"></div>
        <p style="margin-top: 1rem; color: var(--text-muted);">@_loadingMessage</p>
    </div>
}
else if (string.IsNullOrWhiteSpace(_error) == false)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column; padding: 2rem; text-align: center;">
        <h3 style="color: var(--danger-color);">Failed to Unlock</h3>
        <p style="margin: 1rem 0;">@_error</p>
        <button class="button" @onclick="GoHome">Back to Login</button>
    </div>
}
else if (State.IsUnlocked)
{
    <VaultView />
}

@code {
    private bool _isLoading = false;
    private string _error = string.Empty;
    private string _loadingMessage = "Unlocking vault...";

    protected override async Task OnInitializedAsync()
    {
        if (State.IsUnlocked)
        {
            return;
        }

        if (State.HasMasterKey == false)
        {
            Nav.NavigateTo("/");
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            (bool success, string? msg) = await UnlockService.UnlockAsync(status =>
            {
                InvokeAsync(() =>
                {
                    _loadingMessage = status;
                    StateHasChanged();
                });
            });

            _isLoading = false;

            if (success)
            {
                // State.Vault is populated, UI updates automatically.
            }
            else
            {
                if (msg == "Connector not configured.")
                {
                    Nav.NavigateTo($"/settings?message={HttpUtility.UrlEncode("Please configure the selected vault connector reader before unlocking.")}");
                }
                else
                {
                    _error = msg ?? "An unknown error occurred while unlocking the vault.";
                }
            }
        }
        catch (Exception ex)
        {
            _isLoading = false;
            _error = $"Vault unlock failed: {ex.Message}";
        }
    }

    private void GoHome()
    {
        State.MasterKey = string.Empty;
        State.Vault = null;
        Nav.NavigateTo("/");
    }
}
