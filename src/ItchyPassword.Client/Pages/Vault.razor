@page "/vault"
@implements IDisposable
@using ItchyPassword.Client.Components
@using ItchyPassword.Core.Services
@inject IAppState AppState
@inject NavigationManager Nav
@inject VaultSession Session

@if (AppState.Status == AppStatus.Unlocking || AppState.Status == AppStatus.LoadingVault)
{
    <div class="page-centered">
        <div class="loading-spinner"></div>
        <p class="loading-message">@AppState.StatusMessage</p>
    </div>
}
else if (AppState.Status == AppStatus.Error)
{
    <div class="vault-error">
        <h3>Failed to Unlock</h3>
        <p>@AppState.StatusMessage</p>
        <div class="button-row">
            @if (Session.MainConnector?.CanRetryAccess == true)
            {
                <button class="button primary" @onclick="RetryAccess">
                    Retry
                </button>
            }
            <button class="button secondary" @onclick="GoHome">Back to Login</button>
            <button class="button secondary" @onclick="GoToSettings">Configure</button>
        </div>
    </div>
}
else if (AppState.Status == AppStatus.Unlocked)
{
    <VaultView />
}

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;

        if (AppState.Status == AppStatus.Locked)
        {
            Nav.NavigateTo("/");
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    private async Task RetryAccess()
    {
        await AppState.RetryUnlockAsync(CancellationToken.None);
    }

    private void GoHome()
    {
        AppState.Lock();
    }

    private void GoToSettings()
    {
        AppState.Configure();
    }
}
