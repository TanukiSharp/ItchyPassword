@page "/vault"
@using ItchyPassword.Client.Components
@using ItchyPassword.Client.Services
@using System.Web
@inject VaultSession Session
@inject IMasterKeyProvider MasterKeyProvider
@inject NavigationManager Nav

@if (_isLoading)
{
    <div class="page-centered">
        <div class="loading-spinner"></div>
        <p class="loading-message">@_loadingMessage</p>
    </div>
}
else if (string.IsNullOrWhiteSpace(_error) == false)
{
    <div class="vault-error">
        <h3>Failed to Unlock</h3>
        <p>@_error</p>
        <div class="button-row">
            @if (Session.ReadConnector?.CanRetryAccess == true)
            {
                <button class="button primary" disabled="@_isRetrying" @onclick="RetryAccess">
                    @(_isRetrying ? "Retrying..." : "Retry")
                </button>
            }
            <button class="button secondary" @onclick="GoHome">Back to Login</button>
        </div>
    </div>
}
else if (Session.IsUnlocked)
{
    <VaultView />
}

@code {
    private bool _isLoading = false;
    private bool _isRetrying = false;
    private string _error = string.Empty;
    private string _loadingMessage = "Unlocking vault...";

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsUnlocked)
        {
            return;
        }

        if (MasterKeyProvider.HasMasterKey == false)
        {
            Nav.NavigateTo("/");
            return;
        }

        await AttemptUnlockAsync();
    }

    /// <summary>
    /// Attempts the full unlock flow (access + load vault).
    /// </summary>
    private async Task AttemptUnlockAsync()
    {
        _isLoading = true;
        _error = string.Empty;
        _loadingMessage = "Accessing vault...";
        StateHasChanged();

        try
        {
            (bool success, string? msg) = await Session.UnlockAsync(status =>
            {
                InvokeAsync(() =>
                {
                    _loadingMessage = status;
                    StateHasChanged();
                });
            });

            _isLoading = false;

            if (success)
            {
                // State.Vault is populated, UI updates automatically.
            }
            else
            {
                if (msg == "Connector not configured.")
                {
                    Nav.NavigateTo($"/settings?message={HttpUtility.UrlEncode("Please configure the selected vault connector reader before unlocking.")}");
                }
                else
                {
                    _error = msg ?? "An unknown error occurred while unlocking the vault.";
                }
            }
        }
        catch (Exception ex)
        {
            _isLoading = false;
            _error = $"Vault unlock failed: {ex.Message}";
        }
    }

    /// <summary>
    /// Retries the unlock flow with a fresh user gesture.
    /// AttemptUnlockAsync calls Session.UnlockAsync, which in turn calls
    /// LoadConfigurationAsync (short-circuits on retry) then AccessAsync (synchronous
    /// preamble preserves the gesture). No special pre-call needed.
    /// </summary>
    private async Task RetryAccess()
    {
        if (Session.ReadConnector is null)
        {
            return;
        }

        _isRetrying = true;
        StateHasChanged();

        try
        {
            await AttemptUnlockAsync();
        }
        finally
        {
            _isRetrying = false;
        }
    }

    private void GoHome()
    {
        MasterKeyProvider.MasterKey = [];
        Session.Vault = null;
        Nav.NavigateTo("/");
    }
}
