@page "/item/new"
@using ItchyPassword.Client.Services
@using ItchyPassword.Client.Components.Editors
@using ItchyPassword.Core.Constants
@inject VaultSession Session
@inject IMasterKeyProvider MasterKeyProvider
@inject NavigationManager Nav

<div class="card page-container">
    <div class="card-header">
        <h3 class="heading-flush">New Item</h3>
    </div>

    <div class="card-body">
        <EditForm Model="_item" OnValidSubmit="SaveAsync">
            <div class="form-group">
                <label>Name</label>
                <input class="input" @bind="_name" @bind:event="oninput" required placeholder="e.g. My Service" />
            </div>

            <div class="form-group">
                <label>Type</label>
                <select class="input" value="@_selectedType" @onchange="OnTypeChanged">
                    <option value="Secret">Secret</option>
                    <option value="StaticKey">Static Key</option>
                </select>
            </div>

            <hr class="section-divider" />

            @if (_selectedType == "StaticKey")
            {
                <StaticKeyEditor @ref="_editor" Item="@_item" />
            }
            else
            {
                <SecretEditor @ref="_editor" Item="@_item" />
            }

            <hr class="section-divider" />

            <MetadataEditor @ref="_metadataEditor" Item="@_item" />

            <div class="form-actions">
                <button class="button primary" type="submit" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_name))">
                    @if (_isSaving) { <span>Saving...</span> } else { <span>Save to vault</span> }
                </button>
                <button class="button secondary" type="button" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>

        @if (string.IsNullOrWhiteSpace(_error) == false)
        {
            <div class="alert danger alert-inline">@_error</div>
        }
    </div>
</div>

@code {
    private string _name = string.Empty;
    private string _selectedType = "Secret";
    private bool _isSaving = false;
    private string _error = string.Empty;

    // Stable Id generated once so re-saves update the same entry.
    private readonly Guid _itemId = Guid.NewGuid();

    // Component reference for calling PrepareForSaveAsync at save time.
    private IItemEditor? _editor;

    // Component reference for finalizing metadata before saving.
    private MetadataEditor? _metadataEditor;

    // Create a temporary VaultItemV2 that the embedded editors can work with.
    private VaultItemV2 _item = null!;

    protected override void OnInitialized()
    {
        if (Session.Vault is null || MasterKeyProvider.HasMasterKey == false)
        {
            Nav.NavigateTo("/");
            return;
        }

        _item = CreateDefaultItem(VaultItemTypeV2.Secret);
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        _selectedType = e.Value?.ToString() ?? "Secret";

        VaultItemTypeV2 newType = _selectedType == "StaticKey"
            ? VaultItemTypeV2.StaticKey
            : VaultItemTypeV2.Secret;

        // Recreate the item to reset parameters for the new type, keeping the same Id.
        _item = CreateDefaultItem(newType);

        // Reset editor reference since the component will be re-created.
        _editor = null;
    }

    private VaultItemV2 CreateDefaultItem(VaultItemTypeV2 type)
    {
        var item = new VaultItemV2
        {
            Id = _itemId,
            Name = string.Empty,
            Type = type,
            CreatedAt = DateTimeOffset.UtcNow,
            LastModified = DateTimeOffset.UtcNow
        };

        if (type == VaultItemTypeV2.Secret)
        {
            item.SetData(new SecretDataV2()
            {
                Cipher = string.Empty,
                CryptoVersion = SecretDataConstants.LatestCryptoVersion,
                Encoding = SecretDataConstants.LatestEncoding,
            });
        }
        else
        {
            item.SetData(new StaticKeyDataV2()
            {
                PublicPart = string.Empty,
                Alphabet = StaticKeyDataConstants.DefaultAlphabet,
                Length = StaticKeyDataConstants.DefaultLength,
                CryptoVersion = StaticKeyDataConstants.LatestCryptoVersion,
                EncodingVersion = StaticKeyDataConstants.LatestEncodingVersion,
            });
        }

        return item;
    }

    private async Task SaveAsync()
    {
        if (Session.Vault is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Name is required.";
            return;
        }

        _isSaving = true;
        _error = string.Empty;

        try
        {
            // Let the editor finalize item data (encrypt, generate, etc.).
            if (_editor is not null)
            {
                bool ready = await _editor.PrepareForSaveAsync();

                if (ready == false)
                {
                    _isSaving = false;
                    return;
                }
            }

            // Let the metadata editor finalize metadata (encrypt flagged values, etc.).
            if (_metadataEditor is not null)
            {
                bool metadataReady = await _metadataEditor.PrepareMetadataAsync();

                if (metadataReady == false)
                {
                    _isSaving = false;
                    return;
                }
            }

            _item.Name = _name.Trim();
            _item.LastModified = DateTimeOffset.UtcNow;

            // Check if this item already exists in the vault (re-save scenario).
            int existingIndex = Session.Vault.Value.Items.FindIndex(i => i.Id == _itemId);

            if (existingIndex >= 0)
            {
                // Update the existing entry.
                Session.Vault.Value.Items[existingIndex] = _item;
            }
            else
            {
                // Add as new entry.
                Session.Vault.Value.Items.Add(_item);
                Session.Vault.Value.Items.Sort((a, b) => StringComparer.OrdinalIgnoreCase.Compare(a.Name, b.Name));
            }

            // Serialize the entire vault and persist to all write connectors.
            var results = await Session.SaveVaultAsync("Create new item via ItchyPassword", CancellationToken.None);
            var failures = results.Where(r => r.Success == false).ToList();

            if (failures.Count > 0)
            {
                _error = "Partial save failure: " + string.Join(", ", failures.Select(f => $"{f.Connector.Name}: {f.Error}"));

                // If ALL connectors failed, rollback. If SOME failed, stay on page but don't rollback.
                if (results.All(r => r.Success == false))
                {
                    Session.Vault.Value.Items.Remove(_item);
                }

                return;
            }

            Nav.NavigateTo("/vault");
        }
        catch (Exception ex)
        {
            _error = $"Save failed: {ex.Message}";
            // Rollback on total failure.
            Session.Vault?.Items.Remove(_item);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/vault");
    }
}
