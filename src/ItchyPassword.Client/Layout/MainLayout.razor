@inherits LayoutComponentBase
@implements IDisposable
@using ItchyPassword.Client.Services
@using ItchyPassword.Core.Services
@using System.ComponentModel
@inject IAppState AppState
@inject VaultSession Session
@inject IMasterKeyProvider MasterKeyProvider
@inject NavigationManager Nav
@inject ErrorLogService ErrorLog

<div class="app-layout">
    <div class="mobile-toggle-bar">
        <button class="hamburger-btn" @onclick="ToggleSidebar">☰</button>
        <span class="mobile-title">ItchyPassword</span>
    </div>

    <aside class="sidebar @(sidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <h2>ItchyPassword</h2>
            <button class="close-sidebar-btn" @onclick="ToggleSidebar">✕</button>
        </div>
        <nav>
            <ul>
                <li><NavLink href="empty" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">🫣 Empty</NavLink></li>
                <li>
                    <NavLink href="vault" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">
                        @(AppState.Status == AppStatus.Loaded ? "🔓" : "🔒") Vault
                    </NavLink>
                </li>
                <li><NavLink href="static-key" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">🔑 Static key</NavLink></li>
                @if (AppState.Status == AppStatus.Loaded)
                {
                    <li>
                        <button class="sidebar-action-link" @onclick="UnloadVaultAsync" title="Clears the master key and unloads all vault data.">🔒 Unload vault</button>
                    </li>
                }
                <li><NavLink href="settings" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">⚙️ Settings</NavLink></li>
            </ul>
            <details class="sidebar-debug-section">
                <summary class="sidebar-debug-toggle">
                    🛠️ Debug
                    @if (ErrorLog.Count > 0)
                    {
                        <span class="sidebar-badge">@ErrorLog.Count</span>
                    }
                </summary>
                <ul>
                    <li><NavLink href="raw-vault" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">📄 Raw Vault</NavLink></li>
                    <li>
                        <NavLink href="error-log" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">
                            ⚠️ Errors
                            @if (ErrorLog.Count > 0)
                            {
                                <span class="sidebar-badge">@ErrorLog.Count</span>
                            }
                        </NavLink>
                    </li>
                </ul>
            </details>
        </nav>
        <ThemeSelector />
        <div class="sidebar-version">@AppVersion.FullVersion</div>
    </aside>

    @if (sidebarOpen)
    {
        <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
    }

    <main class="main-content">
        @Body
    </main>
</div>

<ToastContainer />

@code {
    private bool sidebarOpen = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
        ErrorLog.OnErrorLogged += OnErrorLogged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        ErrorLog.OnErrorLogged -= OnErrorLogged;
    }

    private void OnErrorLogged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void CloseSidebar()
    {
        sidebarOpen = false;
    }

    private async Task UnloadVaultAsync()
    {
        sidebarOpen = false;
        await AppState.UnloadAsync();
    }
}
