@inherits LayoutComponentBase
@implements IDisposable
@using ItchyPassword.Client.Services
@inject NavigationManager Nav
@inject VaultSession Session
@inject IMasterKeyProvider MasterKeyProvider

<div class="app-layout">
    @if (MasterKeyProvider.HasMasterKey)
    {
        <div class="mobile-toggle-bar">
            <button class="hamburger-btn" @onclick="ToggleSidebar">☰</button>
            <span class="mobile-title">ItchyPassword</span>
        </div>

        <aside class="sidebar @(sidebarOpen ? "open" : "")">
            <div class="sidebar-header">
                <h2>ItchyPassword</h2>
                <button class="close-sidebar-btn" @onclick="ToggleSidebar">✕</button>
            </div>
            <nav>
                <ul>
                    @if (Session.IsUnlocked)
                    {
                        <li><NavLink href="vault" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">🔓 Vault</NavLink></li>
                    }
                    else
                    {
                        <li><span>🔒 Vault</span></li>
                    }
                    <li><NavLink href="static-key" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">🔑 Static Key</NavLink></li>
                    <li><NavLink href="settings" Match="NavLinkMatch.Prefix" @onclick="CloseSidebar">⚙️ Settings</NavLink></li>
                </ul>
            </nav>
            <div class="sidebar-version">@AppVersion.FullVersion</div>
        </aside>

        @if (sidebarOpen)
        {
            <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
        }
    }

    <main class="main-content">
        @Body
    </main>
</div>


@code {
    private bool sidebarOpen = false;

    protected override void OnInitialized()
    {
        Session.PropertyChanged += OnStateChanged;
    }

    private void OnStateChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(VaultSession.IsUnlocked))
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Session.PropertyChanged -= OnStateChanged;
    }

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void CloseSidebar()
    {
        sidebarOpen = false;
    }
}
