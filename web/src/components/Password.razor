@page "/password"
@namespace ItchyPassword.App.Pages
@inject IPasswordGeneratorService PasswordGenerator
@inject IVaultService VaultService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Password Generator</PageTitle>

<h1>Password Generator</h1>

@if (!VaultService.IsUnlocked)
{
    <div class="alert alert-warning">
        Please unlock with Master Key first. <a href="">Go to Master Key</a>.
    </div>
}
else
{
    <div class="mb-3">
        <label for="publicPart" class="form-label">Public Part</label>
        <input type="text" class="form-control" id="publicPart" @bind="PublicPart" @bind:event="oninput" />
        <div class="form-text">Length: @PublicPart?.Length</div>
    </div>

    <div class="mb-3">
        <label for="length" class="form-label">Length: @Length</label>
        <input type="range" class="form-range" id="length" min="4" max="128" @bind="Length" @bind:event="oninput" />
    </div>

    <div class="mb-3">
         <label for="alphabet" class="form-label">Alphabet</label>
         <input type="text" class="form-control" id="alphabet" @bind="Alphabet" />
    </div>

    <div class="mb-3">
         <label for="version" class="form-label">Version</label>
         <select class="form-select" id="version" @bind="Version">
             <option value="1">Version 1</option>
             <option value="2">Version 2</option>
         </select>
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Generated Password</label>
        <div class="input-group">
            <input type="text" class="form-control" id="password" value="@GeneratedPassword" readonly />
            <button class="btn btn-outline-secondary" type="button" @onclick="CopyToClipboard">Copy</button>
        </div>
    </div>
}

@code {
    private string PublicPart { get; set; } = "";
    private int Length { get; set; } = 64;
    private string Alphabet { get; set; } = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    private int Version { get; set; } = 2;

    private string GeneratedPassword => PasswordGenerator.Generate(VaultService.MasterKey ?? "", PublicPart, Alphabet, Length, Version);

    private async Task CopyToClipboard()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", GeneratedPassword);
    }
}
